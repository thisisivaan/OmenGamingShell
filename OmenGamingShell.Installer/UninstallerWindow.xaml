<Window x:Class="OmenGamingShell.Installer.UninstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall OMEN Gaming Shell" WindowStyle="None" ResizeMode="NoResize"
        Width="540" Height="380" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="White"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid>
        <Border MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown" Background="Transparent" Height="40" VerticalAlignment="Top" />

        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="36" Height="36" Margin="0,4,8,0"
                Click="CloseButton_Click" Cursor="Hand"
                Background="Transparent" Foreground="#666" BorderThickness="0"
                FocusVisualStyle="{x:Null}" />

        <!-- Step 1: Options -->
        <Grid x:Name="Step1_Options" Visibility="Visible" Margin="0,40,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                <TextBlock Text="UNINSTALL" Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="OMEN Gaming Shell" Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,24" />

                <TextBlock Style="{StaticResource Subtext}" TextAlignment="Center"
                           Text="This will remove OMEN Gaming Shell from your system. Windows Explorer will be restored as your default shell."
                           Margin="0,0,0,24" />

                <CheckBox x:Name="DeleteDataCheck" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,4">
                    <TextBlock Foreground="White" FontSize="13">
                        <Run Text="Delete all app data" FontWeight="SemiBold" />
                    </TextBlock>
                </CheckBox>
                <Border Background="#0AFFFFFF" CornerRadius="8" Padding="12,10" Margin="24,0,0,20">
                    <TextBlock Style="{StaticResource Subtext}" FontSize="11" Foreground="#707070"
                               Text="Removes settings, game library, cached metadata, play history, and all other data from %LocalAppData%\OmenGamingShell" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="CANCEL" Style="{StaticResource SecondaryButton}"
                            Width="120" Click="Cancel_Click" Margin="0,0,12,0" />
                    <Button Content="UNINSTALL" Style="{StaticResource PrimaryButton}"
                            Width="200" Click="Uninstall_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Step 2: Uninstalling / Complete -->
        <Grid x:Name="Step2_Progress" Visibility="Collapsed" Margin="0,40,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <TextBlock x:Name="UninstallTitle" Text="UNINSTALLING" Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock x:Name="UninstallStatusText" Style="{StaticResource Subtext}"
                           HorizontalAlignment="Center" Text="Removing files..." Margin="0,0,0,24" />
                <ProgressBar x:Name="UninstallProgress" Height="4" Minimum="0" Maximum="100"
                             Background="#222222" Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" />
                <TextBlock x:Name="UninstallDoneText" Style="{StaticResource Subtext}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,24,0,0"
                           Visibility="Collapsed" />
                <Button x:Name="DoneButton" Content="DONE" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Width="160" Margin="0,20,0,0"
                        Visibility="Collapsed" Click="DoneButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
