<Window x:Class="OmenGamingShell.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMEN Gaming Shell Setup" Width="900" Height="570" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" Foreground="White"
        AllowsTransparency="True" Icon="Assets/omen-icon.png" UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextRenderingMode="Auto">
    <Border Margin="1" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="16"
            Background="#050505" ClipToBounds="True" SnapsToDevicePixels="True">
        <Grid Margin="42,32">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border Width="330" Height="58" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                    <Border.OpacityMask><ImageBrush ImageSource="Assets/omen-wordmark-mask.png" Stretch="Uniform"/></Border.OpacityMask>
                </Border>
                <Button Content="×" Width="42" Height="42" HorizontalAlignment="Right" VerticalAlignment="Top"
                        FontSize="22" Background="Transparent" Click="Close_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,42,0,30">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="INSTALL OMEN GAMING SHELL" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="A controller-first Windows gaming environment." Foreground="#A0A0A0" FontSize="15" Margin="0,12,0,28"/>
                    <TextBlock Text="INSTALL LOCATION" Foreground="#808080" FontSize="11"/>
                    <Button Height="44" Margin="0,8,70,26" Padding="18,0" Click="ChooseInstallPath_Click"
                            AutomationProperties.Name="Choose installation folder">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="InstallPathText" VerticalAlignment="Center" FontSize="12"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="CHANGE" Foreground="#B8B8B8" FontSize="10"
                                       Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <CheckBox x:Name="DesktopShortcutCheck" Content="Create a desktop shortcut" IsChecked="True"/>
                    <CheckBox x:Name="StartMenuShortcutCheck" Content="Add to the Start Menu" IsChecked="True"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Ellipse Width="230" Height="230" Fill="#0F0000"/>
                    <Image Source="Assets/omen-icon.png" Width="190" Height="190" Stretch="Uniform"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="2">
                <ProgressBar x:Name="InstallProgress" Height="4" Minimum="0" Maximum="100" Background="#18FFFFFF"
                             Foreground="{StaticResource AccentBrush}" BorderThickness="0" VerticalAlignment="Bottom" Margin="0,0,230,18"/>
                <TextBlock x:Name="StatusText" Text="READY TO INSTALL" Foreground="#8E8E8E" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                <Button x:Name="InstallButton" Content="INSTALL" Width="190" Height="52" HorizontalAlignment="Right" Click="Install_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
