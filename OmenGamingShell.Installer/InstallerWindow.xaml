<Window x:Class="OmenGamingShell.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMEN Gaming Shell Setup" WindowStyle="None" ResizeMode="NoResize"
        Width="640" Height="440" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="White"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid>
        <!-- Drag area -->
        <Border MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown" Background="Transparent" Height="40" VerticalAlignment="Top" />

        <!-- Close button -->
        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="36" Height="36" Margin="0,4,8,0"
                Click="CloseButton_Click" Cursor="Hand"
                Background="Transparent" Foreground="#666" BorderThickness="0"
                FocusVisualStyle="{x:Null}" />

        <!-- Step 1: Welcome -->
        <Grid x:Name="Step1_Welcome" Visibility="Visible" Margin="0,40,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                <TextBlock Text="OMEN" Style="{StaticResource SectionTitle}" FontSize="42"
                           HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,8" />
                <TextBlock Text="GAMING SHELL" Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Style="{StaticResource Subtext}" TextAlignment="Center"
                           Text="A fullscreen gaming launcher that replaces your Windows desktop with an immersive console-like experience. Manage games, control media, monitor performance, and switch between operating systems — all from one interface." Margin="0,0,0,32" />
                <TextBlock Style="{StaticResource Subtext}" TextAlignment="Center" FontSize="11"
                           Foreground="#666" Text="Requires Windows 10 (build 19041) or later. The installer will set up OMEN Gaming Shell for the current user." Margin="0,0,0,32" />
                <Button Content="GET STARTED" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Width="200" Click="Next_Click" Tag="1" />
            </StackPanel>
        </Grid>

        <!-- Step 2: Install Location + Options -->
        <Grid x:Name="Step2_Location" Visibility="Collapsed" Margin="0,40,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                <TextBlock Text="INSTALL OPTIONS" Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" Margin="0,0,0,24" />

                <TextBlock Text="INSTALL LOCATION" Style="{StaticResource Subtext}" FontSize="11"
                           FontWeight="SemiBold" Foreground="#808080" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Height="40"
                            Padding="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="InstallPathText" VerticalAlignment="Center"
                                   FontSize="13" Foreground="#D0D0D0" />
                    </Border>
                    <Button Content="BROWSE" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Height="40" Width="100" Margin="8,0,0,0" Click="Browse_Click" />
                </Grid>

                <CheckBox x:Name="SetAsShellCheck" Style="{StaticResource DarkCheckBox}"
                          IsChecked="True" Margin="0,0,0,4">
                    <TextBlock Text="Set as default shell (replace Explorer on login)" Foreground="White" FontSize="13" />
                </CheckBox>
                <TextBlock Style="{StaticResource Subtext}" FontSize="11" Foreground="#606060"
                           Text="You can change this later from the shell's settings." Margin="24,0,0,20" />

                <CheckBox x:Name="CreateShortcutCheck" Style="{StaticResource DarkCheckBox}"
                          IsChecked="True">
                    <TextBlock Text="Create Start Menu shortcut" Foreground="White" FontSize="13" />
                </CheckBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                    <Button Content="BACK" Style="{StaticResource SecondaryButton}"
                            Width="120" Click="Back_Click" Margin="0,0,12,0" />
                    <Button Content="INSTALL" Style="{StaticResource PrimaryButton}"
                            Width="200" Click="Install_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Step 3: Installing -->
        <Grid x:Name="Step3_Installing" Visibility="Collapsed" Margin="0,40,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <TextBlock Text="INSTALLING" Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock x:Name="InstallStatusText" Style="{StaticResource Subtext}"
                           HorizontalAlignment="Center" Text="Preparing..." Margin="0,0,0,24" />
                <ProgressBar x:Name="InstallProgress" Height="4" Minimum="0" Maximum="100"
                             Background="#222222" Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" />
            </StackPanel>
        </Grid>

        <!-- Step 4: Complete -->
        <Grid x:Name="Step4_Complete" Visibility="Collapsed" Margin="0,40,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                           HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,12" />
                <TextBlock Text="INSTALLATION COMPLETE" Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock x:Name="CompleteSummary" Style="{StaticResource Subtext}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24" />
                <CheckBox x:Name="LaunchOnFinishCheck" Style="{StaticResource DarkCheckBox}"
                          IsChecked="True" HorizontalAlignment="Center">
                    <TextBlock Text="Launch OMEN Gaming Shell" Foreground="White" FontSize="13" />
                </CheckBox>
                <Button Content="FINISH" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Width="200" Margin="0,20,0,0"
                        Click="Finish_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
