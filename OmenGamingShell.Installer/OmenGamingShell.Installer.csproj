<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assets\omen-icon.ico</ApplicationIcon>
    <AssemblyName>OmenGamingShellInstaller</AssemblyName>
    <RootNamespace>OmenGamingShell.Installer</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyTitle>OMEN Gaming Shell Installer</AssemblyTitle>
    <Description>Installer for OMEN Gaming Shell</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Payload\OmenGamingShell.zip" Condition="Exists('Payload\OmenGamingShell.zip')" />
    <Resource Include="Assets\omen-icon.ico" />
  </ItemGroup>
</Project>
