<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OmenGamingShellInstaller</AssemblyName>
    <RootNamespace>OmenGamingShell.Installer</RootNamespace>
    <ApplicationIcon>..\OmenGamingShell\Assets\omen-icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <Product>OMEN Gaming Shell Installer</Product>
    <FileDescription>OMEN Gaming Shell Installer</FileDescription>
    <Company>OMEN Gaming Shell</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\OmenGamingShell\Assets\omen-wordmark-mask.png" Link="Assets\omen-wordmark-mask.png" />
    <Resource Include="..\OmenGamingShell\Assets\omen-icon.png" Link="Assets\omen-icon.png" />
    <Resource Include="Payload\OmenGamingShell.zip" />
  </ItemGroup>
</Project>
