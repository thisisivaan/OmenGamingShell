<Window x:Class="OmenGamingShell.ToastOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" IsHitTestVisible="True" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" Cursor="Hand"
        MouseLeftButtonDown="ToastOverlay_MouseLeftButtonDown">
    <Border x:Name="ToastCard" CornerRadius="18" Padding="22,14" MaxWidth="640">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F2420C0C" Offset="0" />
                <GradientStop Color="#F20B0B0B" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#55FF003C" Offset="0" />
                <GradientStop Color="#33FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <TextBlock x:Name="ToastText" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="596" Foreground="White" />
    </Border>
</Window>