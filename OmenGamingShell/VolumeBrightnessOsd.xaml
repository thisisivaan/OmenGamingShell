<Window x:Class="OmenGamingShell.VolumeBrightnessOsd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="320" Height="104" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" ResizeMode="NoResize" IsHitTestVisible="False"
        WindowStartupLocation="Manual">
    <Border x:Name="OsdCard" CornerRadius="16" Padding="18,14"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F2330A0A" Offset="0" />
                <GradientStop Color="#F20B0B0B" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#55FF003C" Offset="0" />
                <GradientStop Color="#33FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OsdIcon" FontFamily="Segoe Fluent Icons" FontSize="26"
                       Foreground="#FF003C" VerticalAlignment="Center" Margin="6,0,16,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="OsdLabel" Text="VOLUME" FontSize="11" FontWeight="SemiBold"
                               Foreground="#C8C8C8" VerticalAlignment="Center" />
                    <TextBlock x:Name="OsdPercent" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"
                               Margin="10,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
                <Border Height="7" Background="#3A000000" CornerRadius="3.5" Margin="0,9,0,0">
                    <Border x:Name="OsdBar" Height="7" Background="#FF003C" CornerRadius="3.5"
                            HorizontalAlignment="Left" Width="0" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>