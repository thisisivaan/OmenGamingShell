                                        <MenuItem x:Name="UnpinQuickLaunchMenuItem" Style="{StaticResource ApplicationContextMenuItem}" Header="UNPIN FROM QUICK LAUNCH" Click="UnpinApplication_Click"
                                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        <MenuItem Style="{StaticResource ApplicationContextMenuItem}"
                                                  Header="{Binding PlacementTarget.Tag.ApplicationMenuActionLabel, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  Click="ApplicationMenuVisibility_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Margin="8">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="136">
                                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ApplicationGlyph}" FontFamily="Segoe UI Symbol" FontSize="25" Foreground="#A0A0A0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=ApplicationIconImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <Image x:Name="ApplicationIconImage" Source="{Binding ApplicationIconPath, Converter={StaticResource ApplicationIconConverter}}" Width="36" Height="36"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                   TextAlignment="Center" HorizontalAlignment="Stretch" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="RUNNING" Foreground="#44DD88" FontSize="9" Margin="0,3,0,0"
                                                   HorizontalAlignment="Center" TextAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
