        <Grid x:Name="GameStorePage" Grid.RowSpan="3" Margin="-52,-34" Background="#C8000000"
              Visibility="Collapsed" MouseDown="GameStorePage_MouseDown">
            <Border Background="#0D0D0D" CornerRadius="14" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="520" MaxHeight="560" MouseDown="GameStorePanel_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top row: back button + title -->
                    <Grid Grid.Row="0" Margin="24,20,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StoreBackButton" Style="{StaticResource BackActionButton}" Content="B"
                                Width="38" Height="38"
                                HorizontalAlignment="Left" Click="StoreBack_Click" AutomationProperties.Name="Back" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="GAME STORE" FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Search field -->
                    <Border Grid.Row="1" Margin="24,20,24,0" CornerRadius="22" Background="#18FFFFFF">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="White" Opacity="0.07" />
                        </Border.Effect>
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#808080"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="StoreSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     FontSize="13" Foreground="White" VerticalContentAlignment="Center"
                                     Margin="28,0,8,0" TextChanged="StoreSearchBox_TextChanged"
                                     AutomationProperties.Name="Search game store" />
                            <TextBlock x:Name="StoreSearchSpinner" Grid.Column="2" Text="&#x27F3;" FontFamily="Segoe Fluent Icons"
                                       FontSize="14" Foreground="#808080" VerticalAlignment="Center" Visibility="Collapsed"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="StoreSearchSpinTransform" Angle="0" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="TextBlock.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Search status -->
                    <TextBlock x:Name="StoreSearchStatus" Grid.Row="2" Margin="24,12,24,0"
                               FontSize="11" Foreground="#707070" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Search results -->
                    <Grid Grid.Row="3" Margin="24,16,24,24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="StoreGamesGrid" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="RowBorder" Background="#121212" CornerRadius="10" Padding="14,12" Margin="0,0,0,8"
                                                Cursor="Hand" Tag="{Binding}" RenderTransformOrigin="0.5,0.5"
                                                MouseLeftButtonDown="StoreResultRow_Click">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="RowScale" ScaleX="1" ScaleY="1" />
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="50" Height="68" CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0"
                                                        VerticalAlignment="Center" Background="#1AFFFFFF">
                                                    <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Developer, TargetNullValue=Unknown developer}"
                                                               FontSize="10" Foreground="#808080" TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Genres}" FontSize="9" Foreground="#606060"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                                        <TextBlock Text="{Binding Rating}" FontSize="9" Foreground="#9B6BFF"
                                                                   Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <!-- Live download/install progress: a thin bar + activity status,
                                                         shown only while the game is downloading or installing. -->
                                                    <StackPanel Margin="0,8,0,0"
                                                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                                                        <Grid Height="4" ClipToBounds="True">
                                                            <Border Background="#20FFFFFF" CornerRadius="2" />
                                                            <Border CornerRadius="2" Background="#E8B83C"
                                                                    HorizontalAlignment="Left" Width="{Binding ProgressWidth}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding ActivityText}" FontSize="9" Foreground="#909090"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- Action icon - always visible circle; a ring around it appears on
                                                     hover (ring sits on top with a transparent hit area, so the whole
                                                     button is hover-aware). On red/yellow rows the whole area is
                                                     clickable; on green (installed) rows it is inert. -->
                                                <Border x:Name="ActionHover" Grid.Column="2" Width="44" Height="44"
                                                        VerticalAlignment="Center" Margin="2,0,0,0"
                                                        Cursor="Hand" MouseLeftButtonDown="StoreResultAction_Click"
                                                        Tag="{Binding}">
                                                    <Grid Width="44" Height="44">
                                                        <!-- Inner circle + glyph, always visible -->
                                                        <Border x:Name="ActionCircle" Width="36" Height="36"
                                                                CornerRadius="18" VerticalAlignment="Center"
                                                                Background="#18FF003C">
                                                            <Grid>
                                                                <TextBlock x:Name="ActionIcon" Text="&#xE896;" FontFamily="Segoe Fluent Icons"
                                                                           FontSize="15" Foreground="#FF003C"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="DownloadSpinIcon" Text="&#xE895;" FontFamily="Segoe Fluent Icons"
                                                                           FontSize="15" Foreground="#E8B83C" Visibility="Collapsed"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           RenderTransformOrigin="0.5,0.5">
                                                                    <TextBlock.RenderTransform>
                                                                        <RotateTransform Angle="0" />
                                                                    </TextBlock.RenderTransform>
                                                                    <TextBlock.Triggers>
                                                                        <EventTrigger RoutedEvent="TextBlock.Loaded">
                                                                            <BeginStoryboard>
                                                                                <Storyboard RepeatBehavior="Forever">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                     From="0" To="360" Duration="0:0:1" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </TextBlock.Triggers>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Hover ring: transparent hit area over the circle, fades in on hover -->
                                                        <Border x:Name="ActionRing" CornerRadius="22" BorderThickness="2"
                                                                Background="Transparent" BorderBrush="#70FF003C" Opacity="0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#70FF003C" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                            <Setter Property="Background" Value="#14FF003C" />
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding HasLocalRepack}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#70E8B83C" />
                                                                            <Setter Property="Background" Value="#14E8B83C" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                            <Setter Property="Opacity" Value="0" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFitGirlAvailable}" Value="False">
                                                                            <Setter Property="Opacity" Value="0" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Local repack on disk, never installed: yellow container.
                                                 Clicking it opens the game-info page (no install icon). -->
                                            <DataTrigger Binding="{Binding HasLocalRepack}" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#14E8B83C" />
                                                <Setter TargetName="ActionIcon" Property="Foreground" Value="#E8B83C" />
                                                <Setter TargetName="ActionCircle" Property="Background" Value="#18E8B83C" />
                                            </DataTrigger>
                                            <!-- No FitGirl repack: greyed out, not clickable -->
                                            <DataTrigger Binding="{Binding IsFitGirlAvailable}" Value="False">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#0D0D0D" />
                                                <Setter TargetName="RowBorder" Property="Opacity" Value="0.45" />
                                                <Setter TargetName="RowBorder" Property="Cursor" Value="Arrow" />
                                                <Setter TargetName="ActionHover" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <!-- Downloading: yellow spin -->
                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                <Setter TargetName="ActionIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DownloadSpinIcon" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ActionCircle" Property="Background" Value="#22E8B83C" />
                                                <Setter TargetName="RowBorder" Property="Background" Value="#10E8B83C" />
                                            </DataTrigger>
                                            <!-- Installing: same yellow spin so the card reads as busy while
                                                 silent setup extracts. -->
                                            <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                <Setter TargetName="ActionIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DownloadSpinIcon" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ActionCircle" Property="Background" Value="#22E8B83C" />
                                                <Setter TargetName="RowBorder" Property="Background" Value="#10E8B83C" />
                                            </DataTrigger>
                                            <!-- Installed: green row + check. The icon is informational only:
                                                 no hover ring, no Hand cursor, clicks are swallowed. -->
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#1224C486" />
                                                <Setter TargetName="ActionIcon" Property="Text" Value="&#xE73E;" />
                                                <Setter TargetName="ActionIcon" Property="Foreground" Value="#24C486" />
                                                <Setter TargetName="ActionCircle" Property="Background" Value="#1824C486" />
                                                <Setter TargetName="ActionHover" Property="Cursor" Value="Arrow" />
                                                <Setter TargetName="ActionHover" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="StoreEmptyText" Text="Search for games on IGDB"
                                   FontSize="13" Foreground="#505050" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Free space on the drive hosting the download folder, pinned to the
                 bottom-left of the store overlay. -->
            <TextBlock x:Name="StoreFreeSpaceText" Text="" FontFamily="Segoe UI Variable Display"
                       FontSize="11" Foreground="#FF4444" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="20,0,0,14" />
        </Grid>

        <!-- Download Center overlay -->
        <Grid x:Name="DownloadCenterPage" Grid.RowSpan="3" Margin="-52,-34" Background="#C8000000"
              Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
              MouseDown="DownloadCenterPage_MouseDown">
            <Border Background="#0D0D0D" CornerRadius="14" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="520" MaxHeight="560" MouseDown="DownloadCenterPanel_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top row: back button + title -->
                    <Grid Grid.Row="0" Margin="24,20,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DownloadCenterBackButton" Style="{StaticResource BackActionButton}" Content="B"
                                Width="38" Height="38"
                                HorizontalAlignment="Left" Click="DownloadCenterBack_Click" AutomationProperties.Name="Back" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="DOWNLOADS" FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ShellIconButton}" Width="38" Height="38"
                                Click="DownloadCenterSettings_Click" AutomationProperties.Name="Download settings" ToolTip="Download settings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#909090" />
                        </Button>
                    </Grid>

                    <!-- Download list -->
                    <Grid Grid.Row="1" Margin="24,20,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DownloadCenterGrid" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="RowBody" Background="#121212" CornerRadius="10" Padding="14,12" Margin="0,0,0,8"
                                                MouseLeftButtonDown="DownloadRow_MouseLeftButtonDown">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <!-- Header row - same layout as a store card: cover, title + meta, status circle -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="50" Height="68" CornerRadius="6" ClipToBounds="True"
                                                            Margin="0,0,12,0" Background="#1AFFFFFF">
                                                        <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#909090"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding ProgressText}" FontSize="9" Foreground="#707070" />
                                                            <TextBlock Text="{Binding SizeText}" FontSize="9" Foreground="#606060"
                                                                       Margin="8,0,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!-- Status circle - visually consistent with the store action circle -->
                                                    <Grid Grid.Column="2" Width="44" Height="44" VerticalAlignment="Center" Margin="2,0,0,0">
                                                        <Border x:Name="DlStatusCircle" Width="36" Height="36"
                                                                CornerRadius="18" VerticalAlignment="Center"
                                                                Background="#18E8B83C">
                                                            <Grid>
                                                                <TextBlock x:Name="DlStatusIcon" Text="{Binding StatusIcon}"
                                                                           FontFamily="Segoe Fluent Icons" FontSize="15"
                                                                           Foreground="{Binding StatusColor}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="DlSpinIcon" Text="&#xE895;" FontFamily="Segoe Fluent Icons"
                                                                           FontSize="15" Foreground="#E8B83C" Visibility="Collapsed"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           RenderTransformOrigin="0.5,0.5">
                                                                    <TextBlock.RenderTransform>
                                                                        <RotateTransform Angle="0" />
                                                                    </TextBlock.RenderTransform>
                                                                    <TextBlock.Triggers>
                                                                        <EventTrigger RoutedEvent="TextBlock.Loaded">
                                                                            <BeginStoryboard>
                                                                                <Storyboard RepeatBehavior="Forever">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                     From="0" To="360" Duration="0:0:1" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </TextBlock.Triggers>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Hover ring over the status circle, mirrors the store card -->
                                                        <Border x:Name="DlStatusRing" CornerRadius="22" BorderThickness="2"
                                                                Background="Transparent" BorderBrush="#70E8B83C" Opacity="0"
                                                                Cursor="Hand" MouseLeftButtonDown="DownloadRow_MouseLeftButtonDown"
                                                                Tag="{Binding}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#70E8B83C" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                            <Setter Property="Background" Value="#14E8B83C" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                                <!-- Progress bar -->
                                                <Grid Grid.Row="1" Margin="62,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Height="4" Grid.Column="0">
                                                        <Border Background="#20FFFFFF" CornerRadius="2" />
                                                        <Border CornerRadius="2" Background="#FF003C"
                                                                HorizontalAlignment="Left" Width="{Binding ProgressWidth}" />
                                                    </Grid>
                                                </Grid>
                                                <!-- Controls -->
                                                <Grid Grid.Row="2" Margin="62,8,0,0" HorizontalAlignment="Right">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource LibraryFilterButton}" Width="28" Height="26"
                                                            Padding="0" Margin="0,0,4,0" Tag="{Binding}"
                                                            Click="DownloadPause_Click" Visibility="{Binding CanPause, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource LibraryFilterButton}" Width="28" Height="26"
                                                            Padding="0" Margin="0,0,4,0" Tag="{Binding}"
                                                            Click="DownloadResume_Click" Visibility="{Binding CanResume, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                                    </Button>
                                                    <Button Grid.Column="2" Style="{StaticResource LibraryFilterButton}" Width="28" Height="26"
                                                            Padding="0" Tag="{Binding}"
                                                            Click="DownloadCancel_Click" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                                    </Button>
                                                    <Button Grid.Column="3" Style="{StaticResource LibraryFilterButton}" Width="28" Height="26"
                                                            Padding="0" Margin="0,0,0,0" Tag="{Binding}" ToolTip="Open download folder"
                                                            Click="OpenDownloadFolder_Click" Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                                    </Button>
                                                    <Button Grid.Column="4" Style="{StaticResource LibraryFilterButton}" Width="28" Height="26"
                                                            Padding="0" Margin="4,0,0,0" Tag="{Binding}" ToolTip="Run installer"
                                                            Click="DownloadInstall_Click" Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="&#xE96E;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Downloading: spinning icon like the store's active download -->
                                            <DataTrigger Binding="{Binding CanPause}" Value="True">
                                                <Setter TargetName="DlStatusIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DlSpinIcon" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="DlStatusCircle" Property="Background" Value="#22E8B83C" />
                                            </DataTrigger>
                                            <!-- Installing: same spinning icon so the row feels alive while
                                                 setup.exe extracts. Ring stays visible for hover/click. -->
                                            <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                <Setter TargetName="DlStatusIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DlSpinIcon" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="DlStatusCircle" Property="Background" Value="#22E8B83C" />
                                            </DataTrigger>
                                            <!-- Detected repack waiting to be installed: yellow container,
                                                 whole row launches the repack setup directly -->
                                            <DataTrigger Binding="{Binding IsDetectedRepack}" Value="True">
                                                <Setter TargetName="RowBody" Property="Background" Value="#14E8B83C" />
                                                <Setter TargetName="RowBody" Property="Cursor" Value="Hand" />
                                            </DataTrigger>
                                            <!-- Completed: green status circle like the store's installed state -->
                                            <DataTrigger Binding="{Binding CanInstall}" Value="True">
                                                <Setter TargetName="DlStatusCircle" Property="Background" Value="#1824C486" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="DownloadCenterEmptyText" Text="No active downloads"
                                   FontSize="13" Foreground="#505050" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Download Settings Overlay -->
        <Grid x:Name="DownloadSettingsOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#C8000000"
              Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
              MouseDown="DownloadSettingsOverlay_MouseDown">
            <Border Background="#0D0D0D" CornerRadius="14" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="420" MouseDown="DownloadSettingsPanel_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="24,20,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DownloadSettingsBackButton" Style="{StaticResource BackActionButton}" Content="B"
                                Width="34" Height="34"
                                HorizontalAlignment="Left" Click="DownloadSettingsBack_Click" AutomationProperties.Name="Back" />
                        <TextBlock Grid.Column="1" Text="DOWNLOAD SETTINGS" FontFamily="Segoe UI Variable Display"
                                   FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="24,20,24,24">
                        <TextBlock Text="Download Location" FontSize="11" Foreground="#808080" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#1AFFFFFF" CornerRadius="8" Padding="12,10">
                                <TextBlock x:Name="DownloadPathText" Text="..." FontSize="11" Foreground="#C0C0C0"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource LibraryFilterButton}" Width="36" Height="34"
                                    Margin="8,0,0,0" Click="ChangeDownloadPath_Click" ToolTip="Browse...">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                            </Button>
                        </Grid>

                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="BackupSettingsOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#C8000000" Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
              MouseDown="BackupSettingsOverlay_MouseDown">
            <Border Width="620" Background="#0D0D0D" CornerRadius="12" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="BackupSettingsPanel_MouseDown">
                <StackPanel>
                    <Button x:Name="BackupSettingsBackButton" Style="{StaticResource BackActionButton}" Content="B"
                            Width="38" Height="42"
                            HorizontalAlignment="Left" Margin="0,0,0,12" Click="BackupSettingsBack_Click"
                            AutomationProperties.Name="Back" />
                    <TextBlock Text="BACKUP STATUS" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <TextBlock Text="FOLDERS TO BACK UP" FontSize="11" Foreground="#888" Margin="0,0,0,8" />
                    <ListBox x:Name="BackupFoldersList" Height="150" ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                    <Grid Margin="0,12,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="ADD FOLDER" Height="44" Click="AddBackupFolder_Click" />
                        <Button Grid.Column="2" Content="REMOVE SELECTED" Height="44" Click="RemoveBackupFolder_Click" />
                    </Grid>
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="AUTOMATIC BACKUP WHEN A DRIVE IS CONNECTED" VerticalAlignment="Center" />
                        <ToggleButton x:Name="AutomaticBackupToggle" Style="{StaticResource SliderToggle}"
                                      HorizontalAlignment="Right" Click="AutomaticBackupToggle_Click" />
                    </Grid>
                    <TextBlock Text="BACKUP DRIVE" FontSize="11" Foreground="#888" Margin="0,0,0,7" />
                    <TextBlock x:Name="BackupSelectedDriveText" Text="NO DRIVE SELECTED" Foreground="#A8A8A8" FontSize="12" Margin="0,0,0,7" />
                    <ComboBox x:Name="BackupDrivePicker" Height="44" DisplayMemberPath="DisplayName"
                              SelectionChanged="BackupDrivePicker_Changed" />
                    <Button Content="BACK UP NOW" Height="50" Margin="0,18,0,0" Click="BackupNow_Click" />
                    <TextBlock x:Name="BackupSettingsMessage" Text="" Foreground="#A8A8A8" FontSize="11"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="PowerOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#C8000000" Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
              MouseDown="PowerOverlay_MouseDown">
            <Border Width="430" Background="#0D0D0D" BorderThickness="0"
                    CornerRadius="12" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="PowerPanel_MouseDown">
                <StackPanel>
                    <Button x:Name="PowerBackButton" Style="{StaticResource BackActionButton}" Content="B"
                            Width="38" Height="38"
                            HorizontalAlignment="Left" Margin="0,0,0,8" Click="PowerOverlayBack_Click"
                            AutomationProperties.Name="Back" />
                    <TextBlock Text="POWER OPTIONS" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <Button Content="SWITCH TO DESKTOP" Height="52" Margin="0,0,0,12"
                            Click="DesktopMode_Click" />
                    <Button Content="CLOSE LAUNCHER  (DEVELOPMENT)" Height="52" Margin="0,0,0,12"
                            Click="CloseLauncher_Click" />
                    <Button Content="LOCK" Height="52" Margin="0,0,0,12" Click="Lock_Click" />
                    <Button Content="RESTART" Height="52" Margin="0,0,0,12" Click="Restart_Click" />
                    <Button Content="SLEEP" Height="52" Margin="0,0,0,12" Click="Sleep_Click" />
                    <Button Content="SHUT DOWN" Height="52" Click="Shutdown_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#C8000000" Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
              MouseDown="SettingsOverlay_MouseDown">
            <Border Width="560" Background="#0D0D0D" BorderThickness="0" CornerRadius="12" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="SettingsPanel_MouseDown">
                <Grid>
                    <Button x:Name="SettingsBackButton" Style="{StaticResource BackActionButton}" Content="B"
                            Width="38" Height="38"
