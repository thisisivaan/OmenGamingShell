                    <StackPanel x:Name="MetadataSettingsPanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="METADATA SETTINGS" FontFamily="Segoe UI Variable Display" FontSize="22"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,26" />
                        <TextBlock Text="METADATA SOURCES" FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
