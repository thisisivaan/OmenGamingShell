                                <TextBlock x:Name="NetworkConnectionText" Text="CHECKING..." FontSize="17" Margin="0,5,0,0" />
                                <TextBlock x:Name="NetworkAddressText" Foreground="#A0A0A0" FontSize="13" Margin="0,4,0,0" />
