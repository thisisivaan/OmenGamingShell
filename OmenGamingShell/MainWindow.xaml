                                <TextBlock x:Name="BluetoothConnectionText" Text="CHECKING..." FontSize="17" Margin="0,5,0,0" />
                                <TextBlock x:Name="BluetoothDetailsText" Foreground="#A0A0A0" FontSize="13" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="BackgroundSettingsPanel" Margin="0,50,0,0" Visibility="Collapsed">
