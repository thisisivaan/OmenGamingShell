<Window x:Class="OmenGamingShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OmenGamingShell"
        Title="OMEN Gaming Shell" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" Topmost="False" Background="{StaticResource BackgroundBrush}"
        Foreground="White" KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseDown="Window_PreviewMouseActivity" PreviewMouseWheel="Window_PreviewMouseActivity"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality">
    <Window.Resources>
        <local:ApplicationIconConverter x:Key="ApplicationIconConverter" />
        <Style x:Key="ErrorPillTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ErrorRoundedListBox" TargetType="ListBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#121212" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False" Padding="0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ApplicationContextMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ApplicationContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="#F20D0D0D" CornerRadius="14" Padding="6">
                    <StackPanel IsItemsHost="True"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TodoCheckButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CheckSurface" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter Property="Background" Value="#B33A44" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeTileButton" TargetType="Button" BasedOn="{StaticResource GameCoverButton}">
            <Setter Property="Background" Value="#B5161616" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="LibraryFilterButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FilterSurface" Background="{TemplateBinding Background}" CornerRadius="22">
                            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="White" Opacity="0.07" /></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FilterSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FilterSurface" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryFilterComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="FilterDropDownToggle" Background="{TemplateBinding Background}"
                                          Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="GlassSurface" Background="{TemplateBinding Background}" CornerRadius="22">
                                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="White" Opacity="0.07" /></Border.Effect>
                                        <Grid Margin="18,0,15,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ContentPresenter VerticalAlignment="Center" />
                                            <Path Grid.Column="1" Data="M0,0 L5,5 L10,0" Stroke="White" StrokeThickness="1.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GlassSurface" Property="Background" Value="#28FFFFFF"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="GlassSurface" Property="Background" Value="#34FFFFFF"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="18,0,38,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#EE151515" CornerRadius="12" Padding="5" Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260"><StackPanel IsItemsHost="True" /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FilterDropDownToggle" Property="Background" Value="#34FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskWindowCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="TaskCardSurface" Background="{TemplateBinding Background}" CornerRadius="13">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="TaskSelectionLine" Width="54" Height="3" CornerRadius="2"
                                    Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TaskCardSurface" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TaskCardSurface" Property="Background" Value="#20FFFFFF" />
                                <Setter TargetName="TaskSelectionLine" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TaskCardSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NetworkStatusCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="#151515" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CardSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16">
                    <ContentPresenter HorizontalAlignment="Stretch" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardSurface" Property="Background" Value="#291219"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CardSurface" Property="Opacity" Value="0.72"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SliderToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="52"/><Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="13" Background="#333"/>
                        <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#C90030"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="52,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image x:Name="FallbackGameBackground" Grid.RowSpan="3" Margin="-52,-34"
               Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Image x:Name="MediaBgBlur" Grid.RowSpan="3" Margin="-52,-34"
               Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" OpacityMask="#AA000000">
            <Image.Effect>
                <BlurEffect Radius="60" KernelType="Gaussian" />
            </Image.Effect>
        </Image>
        <Rectangle x:Name="GameBackgroundShade" Grid.RowSpan="3" Margin="-52,-34" Opacity="0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#66000000" Offset="0" />
                    <GradientStop Color="#E6050505" Offset="0.72" />
                    <GradientStop Color="#FF050505" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="BrandGroup" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="OmenBrand" Grid.Column="0" Width="156" Height="27"
                           HorizontalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5"
                           Fill="{StaticResource OmenBrandBrush}" Cursor="Hand"
                           MouseLeftButtonDown="OmenBrand_Click">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BootBrandScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="BrandTranslation" />
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="/Assets/omen-wordmark-mask.png" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Viewbox x:Name="GameLibraryHeaderHost" Grid.Row="1" Grid.Column="0" Width="156" Height="18"
                         Margin="0,4,0,0" Stretch="Fill" Opacity="0" Cursor="Hand"
                         MouseLeftButtonDown="GameLibraryHeader_Click">
                    <TextBlock x:Name="GameLibraryHeader" Style="{StaticResource ShellSectionHeader}"
                               Text="G A M E   L I B R A R Y" Foreground="White" />
                </Viewbox>
            </Grid>
            <StackPanel x:Name="ShellTopStatus" Grid.Column="1" HorizontalAlignment="Right" Opacity="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="ClockText" VerticalAlignment="Center" FontSize="26" FontWeight="SemiBold" />
                    <Grid Margin="10,1,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18" Height="7" Background="#242424" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Left">
                                <Border x:Name="BatteryFill" Width="16" Margin="1" Background="{StaticResource AccentBrush}"
                                        CornerRadius="1" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ChargingIcon" Grid.Column="1" Text="&#x26A1;" Margin="4,-1,0,0"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Symbol" FontSize="12"
                                   Foreground="#B8B8B8" Visibility="Collapsed" />
                        <TextBlock x:Name="WifiStatusIcon" Grid.Column="2" Text="&#xE701;" Margin="9,0,0,0"
                                   VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="14"
                                   Foreground="#B8B8B8" Cursor="Hand"
                                   MouseLeftButtonDown="WifiStatusIcon_Click" />
                        <TextBlock x:Name="BluetoothStatusIcon" Grid.Column="3" Text="&#xE702;" Margin="9,0,0,0"
                                   VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="14"
                                   Foreground="#B8B8B8" Cursor="Hand"
                                   MouseLeftButtonDown="BluetoothStatusIcon_Click" />
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="DateText" HorizontalAlignment="Right" FontSize="14" Foreground="#A0A0A0" />
            </StackPanel>
        </Grid>

        
            <Grid x:Name="LibraryArea" Grid.Row="1" Margin="0,42,0,32" Opacity="0" IsHitTestVisible="False">
            <Border x:Name="ContinueHost" VerticalAlignment="Top"
                    Margin="0,8,1132,0" Height="184" Focusable="True"
                    CornerRadius="14"
                    Visibility="Collapsed" ClipToBounds="True"
                    KeyDown="ContinueHost_KeyDown"
                    IsKeyboardFocusWithinChanged="ContinueHost_FocusWithinChanged">
                <Border.Background>
                    <ImageBrush x:Name="ContinueCoverBrush" Stretch="UniformToFill" />
                </Border.Background>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border CornerRadius="14" ClipToBounds="True">
                <Grid>
                    <Border VerticalAlignment="Bottom" Padding="12,10"
                            CornerRadius="0,0,14,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#EE000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel x:Name="ContinueContent">
                            <TextBlock x:Name="ContinueGameName" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="900" TextWrapping="NoWrap"
                                       Foreground="White" />
                            <TextBlock Text="Continue where you left off..." Foreground="#AAAAAA" FontSize="9"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ContinueWelcomeText" Visibility="Collapsed"
                               FontSize="16" FontWeight="SemiBold" Foreground="White"
                               Text="Welcome to OMEN Shell" VerticalAlignment="Bottom" Padding="12,10" />
                </Grid>
                </Border>
            </Border>
            <Border x:Name="MediaControlsBar" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,738,0" Width="380" Height="184" Padding="10"
                    CornerRadius="14" BorderBrush="#12FFFFFF" BorderThickness="1" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#26FFFFFF" Offset="0" />
                        <GradientStop Color="#10FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="164" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Album Art -->
                    <Border Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Focusable="True" Cursor="Hand" MouseLeftButtonUp="AlbumArt_Click"
                            KeyDown="AlbumArt_KeyDown">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <Border ClipToBounds="True" CornerRadius="14"
                                Width="144" Height="144"
                                Background="#10FFFFFF">
                            <Image x:Name="MediaAlbumArt" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Border>
                    <!-- Controls side -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="MediaTitle" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0"
                                   TextTrimming="CharacterEllipsis" TextAlignment="Left" HorizontalAlignment="Stretch" MaxWidth="170" />
                        <TextBlock x:Name="MediaArtist" Text="" FontSize="10" Foreground="#606060"
                                   TextTrimming="CharacterEllipsis" TextAlignment="Left" HorizontalAlignment="Stretch" Margin="0,4,0,0" MaxWidth="170" />
                        <!-- Buttons row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Border x:Name="MediaPrevBorder" Background="#18FFFFFF" CornerRadius="14" Width="30" Height="30" Margin="3"
                                    Cursor="Hand" Focusable="True"
                                    MouseLeftButtonDown="MediaPrev_Click" KeyDown="MediaButton_KeyDown">
                                <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#E0E0E0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <Border x:Name="MediaPlayBorder" Background="#18FFFFFF" CornerRadius="18" Width="38" Height="38" Margin="3"
                                    Cursor="Hand" Focusable="True"
                                    MouseLeftButtonDown="MediaPlayPause_Click" KeyDown="MediaButton_KeyDown">
                                <TextBlock x:Name="MediaPlayIcon" Text="&#xEDB8;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#E0E0E0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <Border x:Name="MediaNextBorder" Background="#18FFFFFF" CornerRadius="14" Width="30" Height="30" Margin="3"
                                    Cursor="Hand" Focusable="True"
                                    MouseLeftButtonDown="MediaNext_Click" KeyDown="MediaButton_KeyDown">
                                <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#E0E0E0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <Border x:Name="OpenSpotifyBorder" Background="#18FFFFFF" CornerRadius="14" Height="30" Margin="6,3,3,3"
                                    Cursor="Hand" Focusable="True"
                                    MouseLeftButtonDown="OpenSpotify_Click" KeyDown="MediaButton_KeyDown" Visibility="Collapsed" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False" />
                                    <TextBlock Text="OPEN SPOTIFY" FontSize="10" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- Progress bar -->
                        <Border Height="2" Background="#303030" CornerRadius="1" HorizontalAlignment="Stretch" Margin="3,6,3,0">
                            <Border x:Name="MediaProgressBar" Height="2" Background="#FF003C" CornerRadius="1" HorizontalAlignment="Left" Width="0" />
                        </Border>
                        <!-- Volume + Brightness -->
                        <Grid Margin="3,6,3,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center" MouseLeftButtonDown="VolumeBar_Click" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Grid.Column="1" Height="3" Background="#303030" CornerRadius="1.5" VerticalAlignment="Center">
                                    <Border x:Name="VolumeBarFill" Height="3" Background="#FF003C" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" />
                                </Border>
                                <TextBlock x:Name="VolumeText" Text="100" Grid.Column="2" FontSize="9" Foreground="#606060" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="22" TextAlignment="Right" />
                            </Grid>
                            <Grid Grid.Column="2" VerticalAlignment="Center" MouseLeftButtonDown="BrightnessBar_Click" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Grid.Column="1" Height="3" Background="#303030" CornerRadius="1.5" VerticalAlignment="Center">
                                    <Border x:Name="BrightnessBarFill" Height="3" Background="#FF003C" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" />
                                </Border>
                                <TextBlock x:Name="BrightnessText" Text="100" Grid.Column="2" FontSize="9" Foreground="#606060" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="22" TextAlignment="Right" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="PerformanceModeHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,0,0" Width="232" Height="184" Padding="10" Visibility="Collapsed"
                    CornerRadius="14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#18FFFFFF" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Accessories + Backup -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Backup Status (top half) -->
                        <Border x:Name="BackupStatusHost" Grid.Row="0" Focusable="True" KeyboardNavigation.IsTabStop="True" MouseLeftButtonUp="BackupStatus_Click" Cursor="Hand"
                                Padding="8,4" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#18FFFFFF" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="B A C K U P   S T A T U S" Foreground="#9A9A9A" FontSize="9"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Ellipse x:Name="BackupStatusDot" Width="7" Height="7" Fill="#777777"
                                             VerticalAlignment="Center" Margin="0,0,6,1" />
                                    <TextBlock x:Name="BackupStatusText" Text="BACKUP NOT SET" Foreground="White"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                </StackPanel>
                                <TextBlock x:Name="BackupLastRunText" Text="ADD FOLDERS AND A DRIVE"
                                           Foreground="#A8A8A8" FontSize="9" Margin="0,3,0,0"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                <Button x:Name="BackupSetupButton" Style="{StaticResource LibraryFilterButton}"
                                        Content="SET UP BACKUP" FontWeight="SemiBold" Height="28" FontSize="10"
                                        MinWidth="140" Margin="0,6,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                                        Click="BackupSetup_Click" />
                                <Button x:Name="EjectDriverButton" Style="{StaticResource LibraryFilterButton}"
                                        Content="EJECT DRIVE" FontWeight="SemiBold" Height="28" FontSize="10"
                                        MinWidth="140" Margin="0,4,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                                        Click="EjectDriver_Click" />
                                <Border Background="#10FFFFFF" CornerRadius="5" Padding="6,3"
                                        HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock x:Name="BackupLocationText" Text="LOCAL DATA BACKUP"
                                               Foreground="#B8B8B8" FontSize="8" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- Accessories (bottom half) -->
                        <Border x:Name="AccessoriesHost" Grid.Row="2" Cursor="Hand" MouseLeftButtonUp="AccessoriesContainer_Click"
                                Padding="4,2" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#18FFFFFF" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Controller -->
                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,10,0">
                                        <Border x:Name="ControllerStatusBtn" Width="38" Height="38" CornerRadius="19"
                                                Background="#40FF003C" Cursor="Hand" MouseLeftButtonDown="ControllerStatus_Click"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#40FF003C" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#70FF003C" /></Trigger>
                                                        <Trigger Property="IsFocused" Value="True"><Setter Property="Background" Value="#70FF003C" /></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                                           Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse x:Name="ControllerIndicatorDot" Width="8" Height="8" Fill="#FF003C"
                                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="CONTROLLER" Foreground="#A8A8A8" FontSize="8"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0" />
                                        <TextBlock x:Name="ControllerStatusText" Text="Disconnected" Foreground="#606060" FontSize="8"
                                                   HorizontalAlignment="Center" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <!-- Earphone / Audio -->
                                    <StackPanel HorizontalAlignment="Center" Margin="10,0,0,0">
                                        <Border x:Name="EarphoneStatusBtn" Width="38" Height="38" CornerRadius="19"
                                                Background="#40FF003C" Cursor="Hand" MouseLeftButtonDown="EarphoneStatus_Click"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#40FF003C" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#70FF003C" /></Trigger>
                                                        <Trigger Property="IsFocused" Value="True"><Setter Property="Background" Value="#70FF003C" /></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="&#xE7F5;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                                           Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse x:Name="EarphoneIndicatorDot" Width="8" Height="8" Fill="#FF003C"
                                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="EARPHONE" Foreground="#A8A8A8" FontSize="8"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0" />
                                        <TextBlock x:Name="EarphoneStatusText" Text="Disconnected" Foreground="#606060" FontSize="8"
                                                   HorizontalAlignment="Center" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="AccessoriesEmptyText" Text="No devices" Foreground="#707070" FontSize="9"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="NotificationsHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,246,0" Width="478" Height="184" Padding="10"
                    CornerRadius="14" Focusable="True"
                    Visibility="Collapsed" MouseLeftButtonUp="NotificationsHost_Click"
                    KeyDown="NotificationsHost_KeyDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#18FFFFFF" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="N O T I F I C A T I O N S" Foreground="#A8A8A8" FontSize="12"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,9" />
                    <ItemsControl x:Name="NotificationsHostList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="#10FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="14"
                                               Foreground="#808080" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Message}" FontSize="9" Foreground="#707070"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NotificationsHostEmpty" Text="No notifications" Foreground="#505050"
                               FontSize="10" HorizontalAlignment="Center" Margin="0,20,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="LibraryFilters" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Bottom" Margin="368,0,0,349" Visibility="Collapsed">
                <Button Style="{StaticResource LibraryFilterButton}" Content="ALL" Width="86" Tag="All" Click="LibraryFilter_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource LibraryFilterButton}" Content="FAVORITES" Width="120" Tag="Favorites" Click="LibraryFilter_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource LibraryFilterButton}" Content="RECENTLY PLAYED" Width="168" Tag="Recent" Click="LibraryFilter_Click" Margin="0,0,8,0" />
                <ComboBox x:Name="StoreFilter" Style="{StaticResource LibraryFilterComboBox}" Width="145" Height="44" Margin="0,0,8,0" SelectionChanged="LibraryFilterPicker_Changed" />
                <Button Style="{StaticResource LibraryFilterButton}" Content="HIDDEN GAMES" Width="148" Tag="Hidden" Click="LibraryFilter_Click" />
            </StackPanel>
            <StackPanel x:Name="HomeTaskWindowsHost" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="0,0,0,390" Visibility="Collapsed">
                <TextBlock Text="O P E N   W I N D O W S" Foreground="#A8A8A8" FontSize="12" Margin="0,0,0,9" />
                <ItemsControl x:Name="HomeTaskWindowList">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Style="{StaticResource TaskWindowCardButton}" Width="220" Height="142" Margin="0,0,12,0"
                                Tag="{Binding}" Click="HomeTaskWindow_Click" AutomationProperties.Name="{Binding Title}">
                            <Grid Margin="9">
                                <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Tag="{Binding}" Background="#090909" CornerRadius="8" ClipToBounds="True" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="3,8,3,0">
                                    <Image Source="{Binding ExecutablePath, Converter={StaticResource ApplicationIconConverter}}" Width="22" Height="22" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Border x:Name="GameSearchHost" Width="360" Height="44" CornerRadius="22"
                    Background="#18FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="0,0,0,349" Panel.ZIndex="100" Visibility="Collapsed">
                <TextBox x:Name="GameSearchBox" Padding="18,10" Background="Transparent"
                         BorderThickness="0" FontSize="15" TextChanged="GameSearchBox_TextChanged"
                         LostKeyboardFocus="GameSearchBox_LostKeyboardFocus"
                         AutomationProperties.Name="Search games" />
            </Border>
            <ScrollViewer x:Name="LibraryScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="True" VerticalAlignment="Bottom">
                <ItemsControl x:Name="GamesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GameCoverButton}" Width="225" Height="300" Margin="0,0,18,18"
                                    Tag="{Binding}" Click="Game_Click"
                                    MouseEnter="Game_MouseEnter" MouseLeave="Game_MouseLeave"
                                    GotKeyboardFocus="Game_GotKeyboardFocus" LostKeyboardFocus="Game_LostKeyboardFocus"
                                    AutomationProperties.Name="{Binding Name}">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource ApplicationContextMenu}">
                                        <MenuItem Style="{StaticResource ApplicationContextMenuItem}"
                                                  Header="{Binding PlacementTarget.Tag.FavoriteActionLabel, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  Click="GameFavoriteContext_Click" />
                                        <MenuItem Style="{StaticResource ApplicationContextMenuItem}"
                                                  Header="{Binding PlacementTarget.Tag.HiddenActionLabel, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  Click="GameHiddenContext_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="225" Height="300">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.RowSpan="2" CornerRadius="10">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border.Background>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cover}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cover}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Text="▶" FontSize="36" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cover}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cover}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <local:StoreIcon StoreName="{Binding StoreName}" Width="15" Height="15"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                     Margin="0,0,9,11" />
                                    <TextBlock Text="★" Foreground="#FF003C" FontSize="20"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="EmptyLibrary" Background="Transparent" Padding="36" Height="300"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="EmptyLibraryTitle" Text="NO GAMES FOUND" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyLibraryMessage" Text="Refresh the library to scan again." Foreground="#A0A0A0"
                               FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="NotificationToast" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,62,0,0" Background="#EE181818" CornerRadius="18" Padding="22,12"
                MinWidth="280" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="NotificationText" FontSize="14" TextWrapping="Wrap" />
        </Border>

        <Border x:Name="ControllerGuideBar" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28" Background="#D91A1A1A" CornerRadius="20" Padding="16,8"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Border Width="70" Height="26" CornerRadius="13" Background="#24FFFFFF" Margin="0,0,6,0"><TextBlock Text="D-PAD" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="NAVIGATE" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Border Width="34" Height="26" CornerRadius="13" Background="#24FFFFFF" Margin="0,0,6,0"><TextBlock x:Name="GuidePreviousTabGlyph" Text="LB" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="LEFT" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border Width="34" Height="26" CornerRadius="13" Background="#24FFFFFF" Margin="0,0,6,0"><TextBlock x:Name="GuideNextTabGlyph" Text="RB" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="RIGHT" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Border Width="34" Height="26" CornerRadius="13" Background="#24FFFFFF" Margin="0,0,6,0"><TextBlock Text="LT" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="GAMES" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border Width="34" Height="26" CornerRadius="13" Background="#24FFFFFF" Margin="0,0,6,0"><TextBlock Text="RT" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="APPS" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Border x:Name="GuideAcceptPill" Width="26" Height="26" CornerRadius="13" Background="#24FFFFFF" Margin="0,0,6,0"><TextBlock x:Name="GuideAcceptGlyph" Text="A" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="SELECT" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Border x:Name="GuideBackPill" Width="26" Height="26" CornerRadius="13" Background="#24FFFFFF" Margin="0,0,6,0"><TextBlock x:Name="GuideBackGlyph" Text="B" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="BACK" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Grid x:Name="TaskSwitcherOverlay" Grid.RowSpan="3" Margin="-52,-34"
              Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
            <Grid.Background>
                <RadialGradientBrush>
                    <RadialGradientBrush.GradientStops>
                        <GradientStop Color="#22151515" Offset="0" />
                        <GradientStop Color="#E60A0A0A" Offset="0.62" />
                        <GradientStop Color="#F2050505" Offset="1" />
                    </RadialGradientBrush.GradientStops>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid Margin="120,60,120,50" MouseDown="TaskSwitcherContent_MouseDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search bar -->
                <Grid Grid.Row="0" Height="56" Margin="0,0,0,28">
                    <Border x:Name="WinKeySearchBorder" CornerRadius="28" Background="#F20F0F0F"
                            BorderBrush="#14FFFFFF" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.35" Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Border Width="1.5" Height="26" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#B0B0B0"
                                       VerticalAlignment="Center" Margin="30,0,0,0" />
                            <TextBox x:Name="WinKeySearchBox" Background="Transparent" BorderThickness="0"
                                     FontSize="21" Padding="58,0,24,0" VerticalContentAlignment="Center"
                                     Foreground="White" CaretBrush="{StaticResource AccentBrush}"
                                     TextChanged="WinKeySearchBox_TextChanged"
                                     GotKeyboardFocus="WinKeySearchBox_GotKeyboardFocus"
                                     LostKeyboardFocus="WinKeySearchBox_LostKeyboardFocus"
                                     AutomationProperties.Name="Search open windows and apps" />
                            <TextBlock Text="" x:Name="WinKeySearchGlyph" FontFamily="Segoe Fluent Icons" FontSize="16"
                                       Foreground="#606060" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,22,0" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- OPEN WINDOWS section label -->
                <StackPanel x:Name="WinKeyWindowsSection" Grid.Row="1" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock Text="O P E N   W I N D O W S" FontSize="11" FontWeight="SemiBold" Foreground="#707070"
                               Margin="4,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Left">
                        <ItemsControl x:Name="TaskWindowList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TaskWindowCardButton}" Width="196" Height="152" Margin="0,0,12,0"
                                            Tag="{Binding}" Click="TaskWindow_Click" AutomationProperties.Name="{Binding Title}">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="96" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border x:Name="ThumbPreview" Tag="{Binding}" Background="#090909" CornerRadius="8" ClipToBounds="True" />
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,0">
                                                <Image Source="{Binding ExecutablePath, Converter={StaticResource ApplicationIconConverter}}"
                                                       Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="145" Foreground="#D0D0D0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- APPS & GAMES section label (only when searching) -->
                <StackPanel x:Name="WinKeyAppsSection" Grid.Row="2" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock Text="A P P S" FontSize="11" FontWeight="SemiBold" Foreground="#707070"
                               Margin="4,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Left">
                        <ItemsControl x:Name="WinKeyAppsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TaskWindowCardButton}" Width="120" Height="130" Margin="0,0,10,0"
                                            Tag="{Binding}" Click="WinKeyApp_Click" HorizontalContentAlignment="Center">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="64" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Background="#0C0C0C" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Width="56" Height="56">
                                                <Image Source="{Binding Cover, Converter={StaticResource ApplicationIconConverter}}"
                                                       Width="40" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="105"
                                                       VerticalAlignment="Top" Margin="0,4,0,0" Foreground="#D0D0D0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Empty state when no windows and no search -->
                <TextBlock x:Name="WinKeyEmptyHint" Grid.Row="3" Text="Start typing to search apps" FontSize="15"
                           Foreground="#505050" HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed" />

                <!-- Dashboard widgets -->
                <Border x:Name="WinKeyDashboard" Grid.Row="4" Height="154" Margin="0,26,0,0" Panel.ZIndex="10"
                        Background="#ED0B0B0B" CornerRadius="18" Padding="14" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="34" ShadowDepth="6" Opacity="0.5" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Top accent hairline -->
                        <Border Grid.Row="0" Height="2" CornerRadius="1" Margin="16,0,16,14" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FF003C" Offset="0" />
                                    <GradientStop Color="#66FF003C" Offset="0.5" />
                                    <GradientStop Color="#00FF003C" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Media -->
                            <Border Grid.Column="0" CornerRadius="13" Padding="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1CFFFFFF" Offset="0" />
                                        <GradientStop Color="#09FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="1.5" Height="30" CornerRadius="1" Background="#FF003C"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Border x:Name="DashMediaArtBorder" Width="54" Height="54" CornerRadius="12"
                                            Background="#10FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                            ClipToBounds="True" VerticalAlignment="Center" Margin="9,0,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.6" Color="#FF003C" />
                                        </Border.Effect>
                                        <Border x:Name="DashMediaArt" CornerRadius="11" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock x:Name="DashMediaTitle" Text="No media" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="DashMediaArtist" Text="" FontSize="9.5" Foreground="#909090"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        <Button x:Name="DashMediaPlayButton" Style="{StaticResource LibraryFilterButton}"
                                                Content="PLAY" FontSize="9" FontWeight="SemiBold" Height="26" Padding="14,4"
                                                Margin="0,9,0,0" HorizontalAlignment="Left" Click="DashMediaPlay_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Continue playing -->
                            <Border Grid.Column="2" CornerRadius="13" Padding="12"
                                    MouseLeftButtonUp="DashContinue_Click" Cursor="Hand">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1CFFFFFF" Offset="0" />
                                        <GradientStop Color="#09FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="1.5" Height="30" CornerRadius="1" Background="#3C9DFF"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Border x:Name="DashContinueArt" Width="54" Height="54" CornerRadius="12"
                                            Background="#10FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                            ClipToBounds="True" VerticalAlignment="Center" Margin="9,0,0,0">
                                        <Border x:Name="DashContinueArtInner" CornerRadius="11" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="CONTINUE PLAYING" FontSize="9" FontWeight="SemiBold" Foreground="#7FA8E0" />
                                        <TextBlock x:Name="DashContinueName" Text="Nothing to resume" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        <TextBlock Text="Resume game  >" FontSize="9" Foreground="#3C9DFF" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Notifications -->
                            <Border Grid.Column="4" CornerRadius="13" Padding="12"
                                    MouseLeftButtonUp="DashNotification_Click" Cursor="Hand">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1CFFFFFF" Offset="0" />
                                        <GradientStop Color="#09FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="1.5" Height="30" CornerRadius="1" Background="#E8B83C"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Border Width="40" Height="40" CornerRadius="11" Background="#14FFFFFF"
                                            VerticalAlignment="Center" Margin="9,0,0,0">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                                   Foreground="#E8B83C" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="NOTIFICATIONS" FontSize="9" FontWeight="SemiBold" Foreground="#D9B96A" />
                                        <TextBlock x:Name="DashNotificationTitle" Text="No notifications" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        <TextBlock x:Name="DashNotificationMessage" Text="" FontSize="9.5" Foreground="#909090"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Performance mode -->
                            <Border Grid.Column="6" CornerRadius="13" Padding="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1CFFFFFF" Offset="0" />
                                        <GradientStop Color="#09FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="1.5" Height="30" CornerRadius="1" Background="#24C486"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0">
                                        <TextBlock Text="PERFORMANCE MODE" FontSize="9" FontWeight="SemiBold" Foreground="#7FD9B4" />
                                        <TextBlock x:Name="DashPerfModeText" Text="BALANCED" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#24C486" Margin="0,3,0,0" />
                                        <UniformGrid Columns="3" Rows="1" Margin="0,8,0,0">
                                            <Button Style="{StaticResource LibraryFilterButton}" Content="ULT" Tag="Ultimate" FontSize="9" FontWeight="SemiBold"
                                                    Height="25" Margin="0,0,5,0" Click="PerformanceMode_Click" />
                                            <Button Style="{StaticResource LibraryFilterButton}" Content="BAL" Tag="Balanced" FontSize="9" FontWeight="SemiBold"
                                                    Height="25" Margin="0,0,5,0" Click="PerformanceMode_Click" />
                                            <Button Style="{StaticResource LibraryFilterButton}" Content="ECO" Tag="Eco" FontSize="9" FontWeight="SemiBold"
                                                    Height="25" Click="PerformanceMode_Click" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Controller prompts -->
            <StackPanel x:Name="TaskControllerPrompts" Orientation="Vertical" VerticalAlignment="Bottom"
                        HorizontalAlignment="Right" Margin="0,0,170,60" Visibility="Collapsed">
                <Border x:Name="TaskAcceptPill" Width="30" Height="30" CornerRadius="15" Background="#20FFFFFF" Margin="0,0,0,6">
                    <TextBlock x:Name="TaskAcceptButtonGlyph" Text="A" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="SELECT" Foreground="#A0A0A0" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,14" />
                <Border x:Name="TaskBackPill" Width="30" Height="30" CornerRadius="15" Background="#20FFFFFF" Margin="0,0,0,6">
                    <TextBlock x:Name="TaskBackButtonGlyph" Text="B" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="CLOSE" Foreground="#A0A0A0" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="AltTabOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E6040404"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="#F20D0D0D" CornerRadius="20" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#22FFFFFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Large centered 16:9 preview -->
                    <Border x:Name="AltTabPreviewBorder" Width="336" Height="189" CornerRadius="12"
                            Background="#0C0C0C" BorderBrush="#FF003C" BorderThickness="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="#FF003C" />
                        </Border.Effect>
                        <Border x:Name="AltTabPreview" ClipToBounds="True" CornerRadius="10" Margin="1" />
                    </Border>
                    <!-- Window title + process pill -->
                    <StackPanel Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Center">
                        <TextBlock x:Name="AltTabWindowTitle" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                        <Border Background="#1AFFFFFF" CornerRadius="10" Padding="14,5" Margin="0,10,0,0"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="AltTabWindowProcess" Foreground="#B0B0B0" FontSize="11"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                        </Border>
                    </StackPanel>
                    <!-- All open windows strip -->
                    <StackPanel Grid.Row="2" Margin="0,24,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="O P E N   W I N D O W S" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#707070" Margin="0,0,0,10" HorizontalAlignment="Center" />
                        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Center" MaxWidth="720">
                            <ItemsControl x:Name="AltTabStripList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="AltTabStripCard" Width="150" Height="120" CornerRadius="11"
                                                Background="#10FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1.5"
                                                Margin="0,0,10,0" Tag="{Binding}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border x:Name="AltTabStripThumb" Tag="{Binding}" Margin="7"
                                                        Background="#090909" CornerRadius="7" ClipToBounds="True" />
                                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="9.5"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="132"
                                                           Foreground="#C8C8C8" Padding="7,0,7,6" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ConnectionsOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E9000000"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
              Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
            <Border Width="760" Background="#0D0D0D" CornerRadius="14" Padding="30" HorizontalAlignment="Center"
                    VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
                <Grid>
                    <StackPanel x:Name="WifiConnectionsPanel" Margin="0,50,0,0">
                        <TextBlock Text="WI-FI NETWORKS" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20" />
                        <Grid>
                        <ListBox x:Name="WifiNetworksList" Height="340" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate><DataTemplate><Grid Width="650" Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="#999" VerticalAlignment="Center"/><Button Grid.Column="2" Style="{StaticResource LibraryFilterButton}" Content="{Binding ActionLabel}" Tag="{Binding}" Height="36" Margin="5,0,0,0" Padding="10,5" FontSize="11" Click="WifiNetworkAction_Click"/></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="WifiScrollArrow" Text="&#x25BC;" FontSize="10" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed" />
                        </Grid>
                        <Grid x:Name="WifiPasswordPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="WifiPasswordBox" Height="44" Padding="12" />
                            <Button Grid.Column="2" Content="CONNECT" Height="44" Click="ConfirmWifiPassword_Click" />
                        </Grid>
                        <Button Content="REFRESH" Height="44" Margin="0,10,0,0" Click="RefreshConnections_Click" />
                    </StackPanel>
                    <StackPanel x:Name="BluetoothConnectionsPanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="BLUETOOTH DEVICES" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20" />
                        <Grid>
                        <ListBox x:Name="BluetoothDevicesList" Height="400" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><Grid Width="650" Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="#999" VerticalAlignment="Center"/><Button Grid.Column="2" Style="{StaticResource LibraryFilterButton}" Content="{Binding ActionLabel}" Tag="{Binding}" Height="36" Margin="5,0,0,0" Padding="10,5" FontSize="11" Click="BluetoothDeviceAction_Click"/></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="BluetoothScrollArrow" Text="&#x25BC;" FontSize="10" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed" />
                        </Grid>
                        <Button Content="REFRESH" Height="44" Margin="0,10,0,0" Click="RefreshConnections_Click" />
                    </StackPanel>
                    <Button x:Name="ConnectionsBackButton" Style="{StaticResource BackActionButton}" Content="B"
                            Width="38" Height="38"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="10" Click="CloseConnections_Click"
                            AutomationProperties.Name="Back" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="AccessoriesOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E9000000"
              Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
            <Border Width="620" Background="#0D0D0D" CornerRadius="14" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
                <StackPanel>
                    <Grid>
                        <Button x:Name="AccessoriesBackButton" Style="{StaticResource BackActionButton}" Content="B"
                                Width="38" Height="38" HorizontalAlignment="Left" Click="CloseAccessoriesOverlay"
                                AutomationProperties.Name="Back" />
                        <TextBlock Text="CONNECTED DEVICES" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,0" />
                    </Grid>
                    <ListBox x:Name="AccessoriesFullList" Height="400" Margin="0,20,0,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="560" Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="20"
                                               Foreground="#A8A8A8" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Connection}" FontSize="10" Foreground="#707070" />
                                            <TextBlock Text="  •  " FontSize="10" Foreground="#505050" />
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10" Foreground="#C90030" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="REFRESH" Height="44" Margin="0,14,0,0" Click="RefreshAccessoriesOverlay" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ShellControls" Grid.Row="2" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="14"
                       Text="READY" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="48" Height="48" Margin="0,0,12,0">
                    <Button x:Name="RefreshButton" Style="{StaticResource ShellRefreshButton}" Click="RefreshGames_Click"
                            AutomationProperties.Name="Rescan games">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="23" />
                    </Button>
                    <ProgressBar x:Name="ScanProgress" Height="3" Minimum="0" Maximum="100" Value="0"
                                 VerticalAlignment="Bottom" Foreground="{StaticResource AccentBrush}"
                                 Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                                 IsHitTestVisible="False" />
                </Grid>
                <Button x:Name="SettingsButton" Style="{StaticResource ShellIconButton}" Width="48" Height="48" Margin="0,0,12,0" Click="Settings_Click"
                        AutomationProperties.Name="Settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="23" />
                </Button>
                <Button x:Name="PowerButton" Style="{StaticResource ShellIconButton}" Width="48" Height="48" Margin="0,0,12,0" Click="PowerOptions_Click"
                        AutomationProperties.Name="Power options">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="24" />
                </Button>
                <Button x:Name="ErrorLogButton" Style="{StaticResource ShellIconButton}" Width="48" Height="48"
                        Click="ErrorLog_Click" AutomationProperties.Name="Error log">
                    <Grid>
                        <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="23" />
                        <Border x:Name="ErrorCountBadge" Background="{StaticResource AccentBrush}" CornerRadius="8"
                                MinWidth="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-3,-5,0" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorCountText" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="GameDetailsPage" Grid.RowSpan="3" Margin="-52,-34" Background="#050505"
              Visibility="Collapsed">
            <Image Source="{Binding Background}" Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#D8050505" Offset="0" />
                        <GradientStop Color="#88050505" Offset="0.58" />
                        <GradientStop Color="#B8050505" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Margin="64,44,64,52">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="DetailsBackButton" Style="{StaticResource BackActionButton}" Content="B"
                        Width="44" Height="44"
                        HorizontalAlignment="Left" Click="DetailsBack_Click" AutomationProperties.Name="Back" />
                <local:StoreIcon Grid.Row="0" StoreName="{Binding StoreName}" Width="26" Height="26"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,10,0" />
                <Grid Grid.Row="1" Margin="0,34,0,28" Width="1252"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="300" Height="400" CornerRadius="14" VerticalAlignment="Top">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Hidden"
                                  HorizontalContentAlignment="Center">
                        <StackPanel Width="900" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable Display"
                                       FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap"
                                       MaxWidth="650" TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Description, TargetNullValue=DESCRIPTION NOT AVAILABLE}"
                                       FontSize="16" Foreground="#D2D2D2" LineHeight="24" TextWrapping="Wrap"
                                       Margin="0,22,0,14" MaxWidth="900" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,30,22">
                                    <TextBlock Text="GENRE" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text="{Binding Genres, TargetNullValue=NOT AVAILABLE}" FontSize="15" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,22">
                                    <TextBlock Text="RELEASE DATE" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text="{Binding ReleaseDate, TargetNullValue=NOT AVAILABLE}" FontSize="15" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,30,22">
                                    <TextBlock Text="DEVELOPER" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text="{Binding Developer, TargetNullValue=NOT AVAILABLE}" FontSize="15" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,22">
                                    <TextBlock Text="PUBLISHER" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text="{Binding Publisher, TargetNullValue=NOT AVAILABLE}" FontSize="15" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="PLATFORMS" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text="{Binding Platforms, TargetNullValue=NOT AVAILABLE}" FontSize="15" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel>
