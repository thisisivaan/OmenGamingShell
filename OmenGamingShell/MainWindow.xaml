                        <TextBlock Text="ERROR LOG" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="ErrorLogList" Grid.Row="1" Margin="0,22,0,18"
                             Style="{StaticResource ErrorRoundedListBox}"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Width="720" Margin="4,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Message}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="10" Foreground="#8A8A8A" Margin="0,5,0,0">
                                        <Run Text="{Binding Source, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding LoggedDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="MARK FIXED" Height="36" Margin="12,0,0,0"
                                        Tag="{Binding}" Click="MarkErrorFixed_Click" />
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Width="720" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="124" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewErrorText" Style="{StaticResource ErrorPillTextBox}"
                                 Height="44" AcceptsReturn="False" KeyDown="NewErrorText_KeyDown"
                                 AutomationProperties.Name="Describe an error" />
                        <Button Grid.Column="2" Content="LOG ERROR" Height="44"
                                FontSize="12" Click="LogError_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="PowerOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#C8000000" Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
              MouseDown="PowerOverlay_MouseDown">
            <Border Width="430" Background="#0D0D0D" BorderThickness="0"
                    CornerRadius="12" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="PowerPanel_MouseDown">
                <StackPanel>
                    <Button Style="{StaticResource BackActionButton}" Content="&lt; Back" Width="90" Height="38"
                            HorizontalAlignment="Left" Margin="0,0,0,8" Click="PowerOverlayBack_Click" />
                    <TextBlock Text="POWER OPTIONS" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <Button Content="SWITCH TO WINDOWS" Height="52" Margin="0,0,0,12"
                            Click="DesktopMode_Click" />
                    <Button Content="SWITCH TO LINUX" Height="52" Margin="0,0,0,12"
                            Click="LinuxMode_Click" />
                    <Button Content="CLOSE LAUNCHER  (DEVELOPMENT)" Height="52" Margin="0,0,0,12"
                            Click="CloseLauncher_Click" />
                    <Button Content="LOCK" Height="52" Margin="0,0,0,12" Click="Lock_Click" />
                    <Button Content="RESTART" Height="52" Margin="0,0,0,12" Click="Restart_Click" />
                    <Button Content="SLEEP" Height="52" Margin="0,0,0,12" Click="Sleep_Click" />
                    <Button Content="SHUT DOWN" Height="52" Click="Shutdown_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#C8000000" Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
              MouseDown="SettingsOverlay_MouseDown">
            <Border Width="560" Background="#0D0D0D" BorderThickness="0" CornerRadius="12" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="SettingsPanel_MouseDown">
                <Grid>
                    <Button Style="{StaticResource BackActionButton}" Content="&lt; Back" Width="90" Height="38"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="10"
                            Click="SettingsOverlayBack_Click" />
                    <StackPanel x:Name="SettingsHomePanel" Margin="0,50,0,0">
                        <TextBlock Text="SETTINGS" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,28" />
                        <Button Content="CONTROLLER SETTINGS" Height="52" Margin="0,0,0,12"
                                Click="ShowControllerSettings_Click" />
                        <Button x:Name="MetadataSettingsHomeButton" Content="METADATA SETTINGS" Height="52" Margin="0,0,0,12"
                                Click="ShowMetadataSettings_Click" />
                        <Button Content="NETWORK SETTINGS" Height="52" Click="ShowNetworkSettings_Click" />
                    </StackPanel>

                    <StackPanel x:Name="ControllerSettingsPanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="CONTROLLER SETTINGS" FontFamily="Segoe UI Variable Display" FontSize="22"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,26" />
                        <TextBlock Text="INPUT METHOD" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,6" />
                        <ComboBox x:Name="InputMethodPicker" Height="44"
                                  SelectionChanged="InputMethodPicker_SelectionChanged" />
                        <Button Content="CONTROLLER CALIBRATION" Height="50" Margin="0,16,0,24"
                                Click="ShowControllerCalibration_Click" />
                        <TextBlock Text="GUIDE BUTTON" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="OPEN OMEN HOME WHILE GAMING" VerticalAlignment="Center" />
                            <ToggleButton x:Name="GuideHomeToggle" Style="{StaticResource SliderToggle}"
                                          HorizontalAlignment="Right" Click="GuideHomeToggle_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="NAVIGATION AUDIO" VerticalAlignment="Center" />
                            <ToggleButton x:Name="NavigationAudioToggle" Style="{StaticResource SliderToggle}"
                                          HorizontalAlignment="Right" Click="NavigationAudioToggle_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="−" Height="42" Click="DecreaseAudioVolume_Click" />
                            <TextBlock x:Name="NavigationAudioVolumeText" Grid.Column="1" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="16" />
                            <Button Grid.Column="2" Content="+" Height="42" Click="IncreaseAudioVolume_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="MetadataSettingsPanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="METADATA SETTINGS" FontFamily="Segoe UI Variable Display" FontSize="22"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,26" />
                        <TextBlock Text="METADATA SOURCES" FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="PRIMARY SOURCE" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,6" />
                        <ComboBox x:Name="PrimarySourcePicker" Height="44" DisplayMemberPath="Name"
                                  SelectionChanged="PrimarySourcePicker_SelectionChanged" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="ADD SOURCE" Height="50" Click="ShowAddSource_Click" />
                            <Button Grid.Column="2" Content="REMOVE SOURCE" Height="50"
                                    Click="ShowRemoveSource_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="NetworkSettingsPanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="NETWORK SETTINGS" FontFamily="Segoe UI Variable Display" FontSize="22"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,24" />
                        <Button Style="{StaticResource NetworkStatusCardButton}" Margin="0,0,0,16"
                                Click="OpenAvailableNetworks_Click" AutomationProperties.Name="Open available Wi-Fi networks">
                            <StackPanel>
                                <TextBlock Text="WI-FI" FontSize="11" Foreground="#888" />
                                <TextBlock x:Name="NetworkConnectionText" Text="CHECKING..." FontSize="17" Margin="0,5,0,0" />
                                <TextBlock x:Name="NetworkAddressText" Foreground="#A0A0A0" FontSize="13" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NetworkStatusCardButton}" Margin="0,0,0,16"
                                Click="OpenBluetoothDevices_Click" AutomationProperties.Name="Open Bluetooth devices">
                            <StackPanel>
                                <TextBlock Text="BLUETOOTH" FontSize="11" Foreground="#888" />
                                <TextBlock x:Name="BluetoothConnectionText" Text="CHECKING..." FontSize="17" Margin="0,5,0,0" />
                                <TextBlock x:Name="BluetoothDetailsText" Foreground="#A0A0A0" FontSize="13" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="ControllerCalibrationPanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="CONTROLLER CALIBRATION" FontFamily="Segoe UI Variable Display"
                                   FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,22" />
                        <TextBlock Text="DETECTED CONTROLLER" FontSize="11" Foreground="#888888" />
                        <TextBlock x:Name="DetectedControllerText" Text="NO CONTROLLER CONNECTED" FontSize="16"
                                   Margin="0,5,0,16" />
                        <TextBlock Text="LIVE INPUT TEST" FontSize="11" Foreground="#888888" />
                        <TextBlock x:Name="ControllerTestText" Text="WAITING FOR INPUT" FontSize="14" Margin="0,5,0,16" />
                        <TextBlock Text="STICK DEAD ZONE" FontSize="11" Foreground="#888888" />
                        <Grid Margin="0,6,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="−" Height="42" Click="DecreaseDeadZone_Click" />
                            <TextBlock x:Name="DeadZoneText" Grid.Column="1" Text="25%" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="+" Height="42" Click="IncreaseDeadZone_Click" />
                        </Grid>
                        <TextBlock Text="BUTTON MAPPING" FontSize="11" Foreground="#888888" Margin="0,0,0,6" />
                        <UniformGrid Columns="2" Rows="3">
                            <ComboBox x:Name="AcceptButtonPicker" Height="42" Margin="0,0,6,8" Tag="Accept" />
                            <ComboBox x:Name="BackButtonPicker" Height="42" Margin="6,0,0,8" Tag="Back" />
                            <ComboBox x:Name="PreviousTabButtonPicker" Height="42" Margin="0,0,6,8" Tag="PreviousTab" />
                            <ComboBox x:Name="NextTabButtonPicker" Height="42" Margin="6,0,0,8" Tag="NextTab" />
                            <ComboBox x:Name="SettingsButtonPicker" Height="42" Margin="0,0,6,0" Tag="Settings" />
                            <ComboBox x:Name="PowerButtonPicker" Height="42" Margin="6,0,0,0" Tag="Power" />
                        </UniformGrid>
                        <Button x:Name="VibrationToggleButton" Content="VIBRATION: ON" Height="46" Margin="0,16,0,8"
                                Click="VibrationToggle_Click" />
                        <Button Content="TEST VIBRATION" Height="46" Margin="0,0,0,8" Click="TestVibration_Click" />
                        <Button Content="SAVE" Height="48" Margin="0,0,0,8" Click="SaveControllerCalibration_Click" />
                    </StackPanel>

                    <StackPanel x:Name="AddMetadataSourcePanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="ADD METADATA SOURCE" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,26" />
                        <TextBlock Text="SOURCE NAME" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,6" />
                        <TextBox x:Name="NewSourceName" Height="44" />
                        <TextBlock Text="API BASE URL" FontSize="12" Foreground="#A0A0A0" Margin="0,18,0,6" />
                        <TextBox x:Name="NewSourceUrl" Height="44" />
                        <TextBlock Text="CLIENT ID (IGDB)" FontSize="12" Foreground="#A0A0A0" Margin="0,18,0,6" />
                        <TextBox x:Name="NewSourceClientId" Height="44" />
                        <TextBlock Text="API KEY / CLIENT SECRET" FontSize="12" Foreground="#A0A0A0" Margin="0,18,0,6" />
                        <PasswordBox x:Name="NewSourceApiKey" Height="44" Padding="10" />
                        <Button Content="SAVE SOURCE" Height="50" Margin="0,20,0,10" Click="SaveSource_Click" />
                        <Button Content="CANCEL" Height="46" Background="Transparent" Click="CancelAddSource_Click" />
                    </StackPanel>

                    <StackPanel x:Name="RemoveSourceListPanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="REMOVE SOURCE" FontFamily="Segoe UI Variable Display" FontSize="22"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,22" />
                        <TextBlock Text="SELECT A SOURCE" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,8" />
                        <ListBox x:Name="RemoveSourcesList" Height="220" DisplayMemberPath="Name"
                                 SelectionChanged="RemoveSourcesList_SelectionChanged" />
                        <Button Content="CANCEL" Height="46" Margin="0,16,0,0" Background="Transparent"
                                Click="CancelRemoveSourceList_Click" />
                    </StackPanel>

                    <StackPanel x:Name="RemoveMetadataSourcePanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="REMOVE METADATA SOURCE" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,22" />
                        <TextBlock x:Name="RemoveConfirmationText" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Its stored API key will also be removed." Foreground="#A0A0A0"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,24" />
                        <Button Content="REMOVE SOURCE" Height="50" Margin="0,0,0,10"
                                Click="ConfirmRemoveSource_Click" />
                        <Button Content="CANCEL" Height="46" Background="Transparent"
                                Click="CancelRemoveSource_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
