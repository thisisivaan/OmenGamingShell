<StackPanel><Grid Margin="0,0,0,16"><TextBlock Text="NOTIFICATIONS" FontSize="14" FontWeight="SemiBold" Foreground="#A0A0A0" VerticalAlignment="Center"/><Button Style="{StaticResource BackActionButton}" Content="B" Width="32" Height="32" HorizontalAlignment="Left" Click="CloseNotificationCenter"/><Button Content="CLEAR ALL" FontSize="10" Foreground="#707070" Background="Transparent" HorizontalAlignment="Right" Click="ClearNotifications_Click" Cursor="Hand"/></Grid>
<Grid>
    <ScrollViewer x:Name="NotificationsScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto" ScrollChanged="ListScroll_Changed"><StackPanel x:Name="NotificationsList"/></ScrollViewer>
    <TextBlock x:Name="NotificationsScrollArrow" Text="&#x25BC;" FontSize="10" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed" />
    </Grid>
<TextBlock x:Name="NotificationsEmpty" Text="No notifications yet" FontSize="13" Foreground="#505050" HorizontalAlignment="Center" Margin="0,30,0,0"/></StackPanel></Border></Grid>

<!-- Update Available Overlay -->
<Grid x:Name="UpdateOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E9000000" Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
  <Border Width="540" MaxHeight="420" Background="#0D0D0D" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
    <StackPanel>
      <TextBlock Text="UPDATE AVAILABLE" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0" HorizontalAlignment="Center" />
      <TextBlock x:Name="UpdateVersionText" FontSize="12" Foreground="#909090" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="460" />
      <TextBlock Text="WHAT'S NEW" FontSize="10" Foreground="#606060" Margin="0,16,0,6" />
      <Border Background="#10FFFFFF" CornerRadius="8">
        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="UpdateNotesText" FontSize="11" Foreground="#B0B0B0" TextWrapping="Wrap" Padding="10" />
        </ScrollViewer>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
        <Button x:Name="UpdateNowButton" Style="{StaticResource LibraryFilterButton}" Content="UPDATE NOW" Width="170" Height="40" Margin="0,0,12,0" Click="UpdateNow_Click" />
        <Button x:Name="UpdateLaterButton" Style="{StaticResource LibraryFilterButton}" Content="NOT NOW" Width="170" Height="40" Click="UpdateLater_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Grid>

<!-- Clipboard Overlay -->
<Grid x:Name="ClipboardOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E9000000" Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
  <Border Width="420" MaxHeight="520" Background="#0D0D0D" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
    <StackPanel><Grid Margin="0,0,0,16"><TextBlock Text="CLIPBOARD" FontSize="14" FontWeight="SemiBold" Foreground="#A0A0A0" VerticalAlignment="Center"/>
    <Button x:Name="ClipboardBackButton" Style="{StaticResource BackActionButton}" Content="B" Width="32" Height="32" HorizontalAlignment="Left" Click="CloseClipboardOverlay"/></Grid>
    <Grid>
    <ScrollViewer x:Name="ClipboardScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto" ScrollChanged="ListScroll_Changed"><StackPanel x:Name="ClipboardList"/></ScrollViewer>
    <TextBlock x:Name="ClipboardScrollArrow" Text="&#x25BC;" FontSize="10" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed" />
    </Grid>
    <TextBlock x:Name="ClipboardEmpty" Text="Nothing copied yet" FontSize="13" Foreground="#505050" HorizontalAlignment="Center" Margin="0,30,0,0"/>
    </StackPanel></Border></Grid>

<!-- Screenshots Overlay -->
<Grid x:Name="ScreenshotsOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E9000000" Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
  <Border Width="640" MaxHeight="560" Background="#0D0D0D" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
    <StackPanel><Grid Margin="0,0,0,16"><TextBlock Text="SCREENSHOTS &amp; CAPTURES" FontSize="14" FontWeight="SemiBold" Foreground="#A0A0A0" VerticalAlignment="Center"/>
    <Button x:Name="ScreenshotsBackButton" Style="{StaticResource BackActionButton}" Content="B" Width="32" Height="32" HorizontalAlignment="Left" Click="CloseScreenshotsOverlay"/>
    <Button Content="OPEN FOLDER" FontSize="10" Foreground="#707070" Background="Transparent" HorizontalAlignment="Right" Click="OpenScreenshotsFolder_Click" Cursor="Hand"/></Grid>
    <WrapPanel x:Name="ScreenshotsPanel"/>
    <TextBlock x:Name="ScreenshotsEmpty" Text="No screenshots found" FontSize="13" Foreground="#505050" HorizontalAlignment="Center" Margin="0,30,0,0"/>
    </StackPanel></Border></Grid>

<!-- Onboarding Overlay -->
<Grid x:Name="OnboardingOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#F2050505" Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
  <Border Background="#0D0D0D" CornerRadius="20" Padding="0" Width="640" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="40" ShadowDepth="4" Opacity="0.4" Color="#000000" />
    </Border.Effect>
    <Grid>
      <!-- Top accent line -->
      <Border Height="3" Background="{StaticResource AccentBrush}" CornerRadius="20,20,0,0" VerticalAlignment="Top" />
      <Grid Margin="0,44,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Icon circle -->
        <Border x:Name="OnboardingIconBorder" Grid.Row="0" Width="80" Height="80" CornerRadius="40"
                Background="#14FF003C" HorizontalAlignment="Center" Margin="0,0,0,24">
          <TextBlock x:Name="OnboardingIcon" Text="" FontFamily="Segoe Fluent Icons" FontSize="36"
                     Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <!-- Title -->
        <TextBlock x:Name="OnboardingTitle" Grid.Row="1" Text="WELCOME TO OMEN SHELL" FontSize="26" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="540" Margin="40,0" />
        <!-- Thin progress bar -->
        <Border Grid.Row="2" Height="3" Background="#1AFFFFFF" CornerRadius="2" Margin="120,16,120,0">
          <Border x:Name="OnboardingProgressBar" Height="3" Background="{StaticResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
        </Border>
        <!-- Step label -->
        <TextBlock x:Name="OnboardingStep" Grid.Row="3" Text="Step 1 of 9" FontSize="11" Foreground="#505050"
                   HorizontalAlignment="Center" Margin="0,10,0,0" />
        <!-- Description -->
        <TextBlock x:Name="OnboardingDesc" Grid.Row="4" FontSize="15" Foreground="#A0A0A0" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Center" LineHeight="24" Margin="40,12,40,0" />
        <!-- Buttons + dots -->
        <StackPanel Grid.Row="5" VerticalAlignment="Bottom" Margin="0,0,0,36">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="OnboardingSkipBtn" Content="SKIP" Style="{StaticResource LibraryFilterButton}" Width="90" Height="36"
                    Margin="0,0,10,0" Click="OnboardingSkip_Click" FontSize="11" />
            <Button x:Name="OnboardingNextBtn" Content="CONTINUE" Style="{StaticResource PrimaryActionButton}" Width="160" Height="36"
                    Click="OnboardingNext_Click" FontSize="12" />
          </StackPanel>
          <ItemsControl x:Name="OnboardingDots" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Grid>

<!-- Performance Details Overlay -->
<Grid x:Name="PerfDetailsOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E9000000" Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
  <Border Width="360" Background="#0D0D0D" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
    <StackPanel><Grid Margin="0,0,0,20"><TextBlock Text="SYSTEM PERFORMANCE" FontSize="14" FontWeight="SemiBold" Foreground="#A0A0A0" VerticalAlignment="Center"/>
    <Button x:Name="PerfBackButton" Style="{StaticResource BackActionButton}" Content="B" Width="32" Height="32" HorizontalAlignment="Left" Click="ClosePerfOverlay"/></Grid>
    <StackPanel Margin="0,0,0,16"><Grid Margin="0,0,0,4"><TextBlock Text="CPU" FontSize="12" Foreground="#A0A0A0"/><TextBlock x:Name="PerfCpuText" Text="--%" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/></Grid>
    <Border Height="6" Background="#242424" CornerRadius="3"><Border x:Name="PerfCpuBar" Height="6" Background="{StaticResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/></Border></StackPanel>
    <StackPanel Margin="0,0,0,16"><Grid Margin="0,0,0,4"><TextBlock Text="RAM" FontSize="12" Foreground="#A0A0A0"/><TextBlock x:Name="PerfRamText" Text="-- / -- GB" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/></Grid>
    <Border Height="6" Background="#242424" CornerRadius="3"><Border x:Name="PerfRamBar" Height="6" Background="#4CAF50" CornerRadius="3" HorizontalAlignment="Left" Width="0"/></Border></StackPanel>
    <TextBlock x:Name="PerfUpdatedText" FontSize="10" Foreground="#505050" Margin="0,10,0,0"/>
    </StackPanel></Border></Grid>
    </Grid>

        </Grid>
</Window>