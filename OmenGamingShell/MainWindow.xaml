                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer x:Name="ApplicationScroller" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" CanContentScroll="True"
                          VerticalAlignment="Bottom" Height="460" Margin="0,0,0,89" Visibility="Collapsed">
