                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,24" />
                        <Button Content="BROWSE FOR IMAGE..." Height="50" Margin="0,0,0,20"
                                Click="BrowseBackground_Click" />
                        <TextBlock Text="CHOOSE A GAME BACKGROUND" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="BackgroundChoiceList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="120" Height="68" Margin="0,0,10,10" Padding="0"
                                                    Background="Transparent" BorderThickness="2"
                                                    Tag="{Binding}" Click="BackgroundChoice_Click"
                                                    ToolTip="{Binding Name}">
                                                <Button.Resources>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FF003C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Resources>
                                                <Grid>
                                                    <Border CornerRadius="6" ClipToBounds="True">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Row="1" Content="RESET TO AUTO SLIDESHOW" Height="44" Margin="0,14,0,0"
                                    Click="ResetBackground_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ControllerCalibrationPanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="CONTROLLER CALIBRATION" FontFamily="Segoe UI Variable Display"
                                   FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,22" />
                        <TextBlock Text="DETECTED CONTROLLER" FontSize="11" Foreground="#888888" />
                        <TextBlock x:Name="DetectedControllerText" Text="NO CONTROLLER CONNECTED" FontSize="16"
                                   Margin="0,5,0,16" />
                        <TextBlock Text="LIVE INPUT TEST" FontSize="11" Foreground="#888888" />
                        <TextBlock x:Name="ControllerTestText" Text="WAITING FOR INPUT" FontSize="14" Margin="0,5,0,16" />
                        <TextBlock Text="STICK DEAD ZONE" FontSize="11" Foreground="#888888" />
                        <Grid Margin="0,6,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="−" Height="42" Click="DecreaseDeadZone_Click" />
                            <TextBlock x:Name="DeadZoneText" Grid.Column="1" Text="25%" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="+" Height="42" Click="IncreaseDeadZone_Click" />
                        </Grid>
                        <TextBlock Text="BUTTON MAPPING" FontSize="11" Foreground="#888888" Margin="0,0,0,6" />
                        <UniformGrid Columns="2" Rows="3">
                            <ComboBox x:Name="AcceptButtonPicker" Height="42" Margin="0,0,6,8" Tag="Accept" />
                            <ComboBox x:Name="BackButtonPicker" Height="42" Margin="6,0,0,8" Tag="Back" />
                            <ComboBox x:Name="PreviousTabButtonPicker" Height="42" Margin="0,0,6,8" Tag="PreviousTab" />
                            <ComboBox x:Name="NextTabButtonPicker" Height="42" Margin="6,0,0,8" Tag="NextTab" />
                            <ComboBox x:Name="SettingsButtonPicker" Height="42" Margin="0,0,6,0" Tag="Settings" />
                            <ComboBox x:Name="PowerButtonPicker" Height="42" Margin="6,0,0,0" Tag="Power" />
                        </UniformGrid>
                        <Button x:Name="VibrationToggleButton" Content="VIBRATION: ON" Height="46" Margin="0,16,0,8"
                                Click="VibrationToggle_Click" />
                        <Button Content="TEST VIBRATION" Height="46" Margin="0,0,0,8" Click="TestVibration_Click" />
                        <Button Content="SAVE" Height="48" Margin="0,0,0,8" Click="SaveControllerCalibration_Click" />
                    </StackPanel>

                    <StackPanel x:Name="AddMetadataSourcePanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="ADD METADATA SOURCE" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,26" />
                        <TextBlock Text="SOURCE NAME" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,6" />
                        <TextBox x:Name="NewSourceName" Height="44" />
                        <TextBlock Text="API BASE URL" FontSize="12" Foreground="#A0A0A0" Margin="0,18,0,6" />
                        <TextBox x:Name="NewSourceUrl" Height="44" />
                        <TextBlock Text="CLIENT ID (IGDB)" FontSize="12" Foreground="#A0A0A0" Margin="0,18,0,6" />
                        <TextBox x:Name="NewSourceClientId" Height="44" />
                        <TextBlock Text="API KEY / CLIENT SECRET" FontSize="12" Foreground="#A0A0A0" Margin="0,18,0,6" />
                        <PasswordBox x:Name="NewSourceApiKey" Height="44" Padding="10" />
                        <Button Content="SAVE SOURCE" Height="50" Margin="0,20,0,10" Click="SaveSource_Click" />
                        <Button Content="CANCEL" Height="46" Background="Transparent" Click="CancelAddSource_Click" />
                    </StackPanel>

                    <StackPanel x:Name="RemoveSourceListPanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="REMOVE SOURCE" FontFamily="Segoe UI Variable Display" FontSize="22"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,22" />
                        <TextBlock Text="SELECT A SOURCE" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,8" />
                        <ListBox x:Name="RemoveSourcesList" Height="220" DisplayMemberPath="Name"
                                 SelectionChanged="RemoveSourcesList_SelectionChanged" />
                        <Button Content="CANCEL" Height="46" Margin="0,16,0,0" Background="Transparent"
                                Click="CancelRemoveSourceList_Click" />
                    </StackPanel>

                    <StackPanel x:Name="RemoveMetadataSourcePanel" Margin="0,50,0,0" Visibility="Collapsed">
                        <TextBlock Text="REMOVE METADATA SOURCE" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,22" />
                        <TextBlock x:Name="RemoveConfirmationText" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Its stored API key will also be removed." Foreground="#A0A0A0"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,24" />
                        <Button Content="REMOVE SOURCE" Height="50" Margin="0,0,0,10"
                                Click="ConfirmRemoveSource_Click" />
                        <Button Content="CANCEL" Height="46" Background="Transparent"
                                Click="CancelRemoveSource_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Notification Center Overlay -->
        <Grid x:Name="NotificationCenterOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E9000000" Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
<Border Width="420" MaxHeight="520" Background="#0D0D0D" CornerRadius="14" Padding="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,80,0" MouseDown="OverlayContent_MouseDown">
<StackPanel><Grid Margin="0,0,0,16"><TextBlock Text="NOTIFICATIONS" FontSize="14" FontWeight="SemiBold" Foreground="#A0A0A0" VerticalAlignment="Center"/><Button Content="CLEAR ALL" FontSize="10" Foreground="#707070" Background="Transparent" HorizontalAlignment="Right" Click="ClearNotifications_Click" Cursor="Hand"/></Grid>
<Grid>
    <ScrollViewer x:Name="NotificationsScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto" ScrollChanged="ListScroll_Changed"><StackPanel x:Name="NotificationsList"/></ScrollViewer>
    <TextBlock x:Name="NotificationsScrollArrow" Text="&#x25BC;" FontSize="10" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed" />
    </Grid>
<TextBlock x:Name="NotificationsEmpty" Text="No notifications yet" FontSize="13" Foreground="#505050" HorizontalAlignment="Center" Margin="0,30,0,0"/></StackPanel></Border></Grid>

<!-- Update Available Banner (macOS-style, top-right, persistent) -->
<Border x:Name="UpdateBanner" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top"
        Margin="0,8,48,0" Width="400" Padding="16" Panel.ZIndex="40" Cursor="Hand"
        Visibility="Collapsed" MouseLeftButtonDown="UpdateBanner_MouseLeftButtonDown">
  <Border.Effect>
    <DropShadowEffect ShadowDepth="10" BlurRadius="22" Opacity="0.55" Color="#000000" />
  </Border.Effect>
  <Border.Style>
    <Style TargetType="Border">
      <Setter Property="Background" Value="#F2161616" />
      <Setter Property="BorderBrush" Value="#26FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
  </Border.Style>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="13" Background="#1FFF003C"
            VerticalAlignment="Top" HorizontalAlignment="Left">
      <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#FF003C"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Border>
    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="UPDATE AVAILABLE" FontSize="10" FontWeight="SemiBold" Foreground="#A8A8A8" />
      <TextBlock x:Name="UpdateBannerVersionText" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"
                 TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
      <TextBlock Text="A newer version is ready to install." FontSize="10" Foreground="#909090"
                 TextWrapping="Wrap" Margin="0,3,0,0" />
    </StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
      <Button x:Name="UpdateBannerNowButton" Style="{StaticResource LibraryFilterButton}" Content="UPDATE NOW"
              Width="116" Height="34" Margin="0,0,8,0" Click="UpdateNow_Click" />
      <Button x:Name="UpdateBannerDismissButton" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="11"
              Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#707070"
              Cursor="Hand" Click="UpdateLater_Click" ToolTip="Dismiss for this session" />
    </StackPanel>
  </Grid>
</Border>

<!-- Downloading Update Overlay -->
<Grid x:Name="UpdateProgressOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#F2050505" Visibility="Collapsed" IsHitTestVisible="True">
  <Border Width="420" Background="#0D0D0D" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel>
      <TextBlock Text="DOWNLOADING UPDATE" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0" HorizontalAlignment="Center" />
      <TextBlock x:Name="UpdateProgressText" FontSize="12" Foreground="#909090" HorizontalAlignment="Center" Margin="0,6,0,0" />
      <ProgressBar IsIndeterminate="True" Height="6" Margin="0,20,0,0" Foreground="#4C9AFF" Background="#20FFFFFF" />
      <TextBlock Text="The shell will restart automatically when the update is ready. Don't turn off your PC." FontSize="11" Foreground="#707070" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
  </Border>
</Grid>

<!-- Clipboard Overlay -->
<Grid x:Name="ClipboardOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E9000000" Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
  <Border Width="420" MaxHeight="520" Background="#0D0D0D" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
    <StackPanel><Grid Margin="0,0,0,16"><TextBlock Text="CLIPBOARD" FontSize="14" FontWeight="SemiBold" Foreground="#A0A0A0" VerticalAlignment="Center"/>
    <Button x:Name="ClipboardBackButton" Style="{StaticResource BackActionButton}" Content="B" Width="32" Height="32" HorizontalAlignment="Left" Click="CloseClipboardOverlay"/></Grid>
    <Grid>
    <ScrollViewer x:Name="ClipboardScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto" ScrollChanged="ListScroll_Changed"><StackPanel x:Name="ClipboardList"/></ScrollViewer>
    <TextBlock x:Name="ClipboardScrollArrow" Text="&#x25BC;" FontSize="10" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed" />
    </Grid>
    <TextBlock x:Name="ClipboardEmpty" Text="Nothing copied yet" FontSize="13" Foreground="#505050" HorizontalAlignment="Center" Margin="0,30,0,0"/>
    </StackPanel></Border></Grid>

<!-- Screenshots Overlay -->
<Grid x:Name="ScreenshotsOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E9000000" Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
  <Border Width="640" MaxHeight="560" Background="#0D0D0D" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
    <StackPanel><Grid Margin="0,0,0,16"><TextBlock Text="SCREENSHOTS &amp; CAPTURES" FontSize="14" FontWeight="SemiBold" Foreground="#A0A0A0" VerticalAlignment="Center"/>
    <Button x:Name="ScreenshotsBackButton" Style="{StaticResource BackActionButton}" Content="B" Width="32" Height="32" HorizontalAlignment="Left" Click="CloseScreenshotsOverlay"/>
    <Button Content="OPEN FOLDER" FontSize="10" Foreground="#707070" Background="Transparent" HorizontalAlignment="Right" Click="OpenScreenshotsFolder_Click" Cursor="Hand"/></Grid>
    <WrapPanel x:Name="ScreenshotsPanel"/>
    <TextBlock x:Name="ScreenshotsEmpty" Text="No screenshots found" FontSize="13" Foreground="#505050" HorizontalAlignment="Center" Margin="0,30,0,0"/>
    </StackPanel></Border></Grid>

<!-- Onboarding Overlay -->
<Grid x:Name="OnboardingOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#F2050505" Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown">
  <Border Background="#0D0D0D" CornerRadius="20" Padding="0" Width="640" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="40" ShadowDepth="4" Opacity="0.4" Color="#000000" />
    </Border.Effect>
    <Grid>
      <!-- Top accent line -->
      <Border Height="3" Background="{StaticResource AccentBrush}" CornerRadius="20,20,0,0" VerticalAlignment="Top" />
      <Grid Margin="0,44,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Icon circle -->
        <Border x:Name="OnboardingIconBorder" Grid.Row="0" Width="80" Height="80" CornerRadius="40"
                Background="#14FF003C" HorizontalAlignment="Center" Margin="0,0,0,24">
          <TextBlock x:Name="OnboardingIcon" Text="" FontFamily="Segoe Fluent Icons" FontSize="36"
                     Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <!-- Title -->
        <TextBlock x:Name="OnboardingTitle" Grid.Row="1" Text="WELCOME TO OMEN SHELL" FontSize="26" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="540" Margin="40,0" />
        <!-- Thin progress bar -->
        <Border Grid.Row="2" Height="3" Background="#1AFFFFFF" CornerRadius="2" Margin="120,16,120,0">
          <Border x:Name="OnboardingProgressBar" Height="3" Background="{StaticResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
        </Border>
        <!-- Step label -->
        <TextBlock x:Name="OnboardingStep" Grid.Row="3" Text="Step 1 of 9" FontSize="11" Foreground="#505050"
                   HorizontalAlignment="Center" Margin="0,10,0,0" />
        <!-- Description -->
        <TextBlock x:Name="OnboardingDesc" Grid.Row="4" FontSize="15" Foreground="#A0A0A0" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Center" LineHeight="24" Margin="40,12,40,0" />
        <!-- Buttons + dots -->
        <StackPanel Grid.Row="5" VerticalAlignment="Bottom" Margin="0,0,0,36">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="OnboardingSkipBtn" Content="SKIP" Style="{StaticResource LibraryFilterButton}" Width="90" Height="36"
                    Margin="0,0,10,0" Click="OnboardingSkip_Click" FontSize="11" />
            <Button x:Name="OnboardingNextBtn" Content="CONTINUE" Style="{StaticResource PrimaryActionButton}" Width="160" Height="36"
                    Click="OnboardingNext_Click" FontSize="12" />
          </StackPanel>
          <ItemsControl x:Name="OnboardingDots" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Grid>

<!-- Uninstall confirmation overlay -->
<Grid x:Name="UninstallConfirmOverlay" Grid.RowSpan="3" Margin="-52,-34" Background="#E9000000"
      KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
      Visibility="Collapsed" MouseDown="DismissibleOverlay_MouseDown" Panel.ZIndex="110">
  <Border Width="520" Background="#0D0D0D" CornerRadius="14" Padding="30"
          HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OverlayContent_MouseDown">
    <StackPanel>
      <TextBlock x:Name="UninstallConfirmTitle" Text="UNINSTALL GAME" FontFamily="Segoe UI Variable Display" FontSize="22"
                 FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
      <TextBlock x:Name="UninstallConfirmGameName" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                 Margin="0,0,0,14" TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock x:Name="UninstallConfirmText" FontSize="13" Foreground="#B0B0B0" HorizontalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
      <TextBlock x:Name="UninstallConfirmFolder" FontSize="11" Foreground="#707070" HorizontalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
      <Button Content="UNINSTALL" Height="50" Margin="0,24,0,10" Click="ConfirmUninstall_Click" />
      <Button Content="CANCEL" Height="46" Background="Transparent" Click="CancelUninstall_Click" />
    </StackPanel>
  </Border>
</Grid>
</Grid>

