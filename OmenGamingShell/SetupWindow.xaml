<Window x:Class="OmenGamingShell.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Up OMEN Gaming Shell" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" Background="{StaticResource BackgroundBrush}"
        Foreground="White" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SetupModeButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ModeSurface" Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ModeSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ModeSurface" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetupFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#A0A0A0" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SkipButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#A0A0A0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SkipSurface" Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetupSectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid Margin="52,38,52,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SetupBackButton" Style="{StaticResource BackActionButton}" Content="B"
                    Width="38" Height="38" Visibility="Collapsed" Click="BackButton_Click"
                    AutomationProperties.Name="Back" />
            <Viewbox Grid.Column="1" Width="150" Height="26" HorizontalAlignment="Center"
                     Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"
                     MouseLeftButtonDown="Brand_Click">
                <Rectangle Width="150" Height="26" Fill="{StaticResource OmenBrandBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="/Assets/omen-wordmark-mask.png" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Viewbox>
            <StackPanel x:Name="SetupStepDots" Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Width="880" MaxHeight="640" Margin="0,34,0,30"
                Background="#0D0D0D" CornerRadius="16" Padding="44,36"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <StackPanel x:Name="WelcomePanel">
                    <TextBlock x:Name="WelcomeTitle" Style="{StaticResource SetupSectionTitle}"
                               Text="WELCOME TO OMEN GAMING SHELL" FontSize="30"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="WelcomeSubtitle" Foreground="#A0A0A0" FontSize="16"
                               Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="A fullscreen shell that turns your PC into a game console — no desktop, no taskbar." />
                    <Border Margin="0,26,0,0" Background="#18FFFFFF" CornerRadius="12" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="BEFORE YOU START" Style="{StaticResource SetupSectionTitle}"
                                       FontSize="15" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Foreground="#D0D0D0" FontSize="14" LineHeight="21" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="Once registered, the shell runs in place of Explorer. If anything ever goes wrong, use the Desktop Mode option in the power menu (or Ctrl+Alt+Shift+E) to get back to Windows while the shell fixes itself." />
                            <TextBlock Text="Take a moment to configure input, performance, and metadata enrichment below." 
                                       Foreground="#A0A0A0" FontSize="14" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="InputPanel" Visibility="Collapsed">
                    <TextBlock Text="HOW WILL YOU CONTROL THE SHELL?" Style="{StaticResource SetupSectionTitle}"
                               FontSize="24" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="Choose your primary input method. A controller is optional but recommended."
                               Foreground="#A0A0A0" FontSize="15" Margin="0,10,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <ComboBox x:Name="SetupInputMethodPicker" Height="48" Margin="0,28,0,0" />
                    <TextBlock Text="You can change this later in Settings &gt; Controller Settings."
                               Foreground="#707070" FontSize="12" Margin="0,16,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="PerformancePanel" Visibility="Collapsed">
                    <TextBlock Text="PICK A PERFORMANCE MODE" Style="{StaticResource SetupSectionTitle}"
                               FontSize="24" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="The shell switches your Windows power plan when you boot in."
                               Foreground="#A0A0A0" FontSize="14" Margin="0,10,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <StackPanel Margin="0,32,0,0">
                        <Button x:Name="SetupUltimateButton" Style="{StaticResource SetupModeButton}" Height="56"
                                Content="ULTIMATE  —  maximum performance, highest power draw"
                                Margin="0,0,0,12" Tag="Ultimate" Click="PerformanceButton_Click" />
                        <Button x:Name="SetupBalancedButton" Style="{StaticResource SetupModeButton}" Height="56"
                                Content="BALANCED  —  recommended for everyday play"
                                Margin="0,0,0,12" Tag="Balanced" Click="PerformanceButton_Click" />
                        <Button x:Name="SetupEcoButton" Style="{StaticResource SetupModeButton}" Height="56"
                                Content="ECO  —  quiet and efficient"
                                Tag="Eco" Click="PerformanceButton_Click" />
                    </StackPanel>
                    <TextBlock Text="You can change this later in Settings &gt; Controller Settings."
                               Foreground="#707070" FontSize="12" Margin="0,22,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="DesktopPanel" Visibility="Collapsed">
                    <TextBlock Text="CHOOSE YOUR DEFAULT DESKTOP" Style="{StaticResource SetupSectionTitle}"
                               FontSize="24" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Foreground="#A0A0A0" FontSize="14" Margin="0,10,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Text="This is where the shell takes you when you choose Switch to Desktop from the power menu." />
                    <ListBox x:Name="SetupDesktopList" Height="188" Margin="0,26,0,0" FontSize="15"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SetupDesktopStatus" VerticalAlignment="Center" FontSize="13"
                                   Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,0,14,0" />
                        <Button x:Name="SetupScanOsButton" Grid.Column="1" Style="{StaticResource SetupModeButton}"
                                Width="220" Content="SCAN FOR OTHER SYSTEMS" Click="ScanOs_Click" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="BackupPanel" Visibility="Collapsed">
                    <TextBlock Text="PROTECT YOUR SAVE DATA" Style="{StaticResource SetupSectionTitle}"
                               FontSize="24" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Foreground="#A0A0A0" FontSize="14" Margin="0,10,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Game saves, configs, and progress can vanish — corrupted files, accidental deletes, or a dead drive. Backups keep you safe." />
                    <Border Margin="0,28,0,0" Background="#18FFFFFF" CornerRadius="12" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="HOW IT WORKS" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Foreground="#D0D0D0" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                                       Text="Every time you launch a game, the shell quietly copies your save folders and configs to a backup drive. No lag, no popups — it runs in the background while you play." />
                            <Border Height="1" Background="#18FFFFFF" Margin="0,16" />
                            <TextBlock Text="WHAT GETS BACKED UP" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Foreground="#A0A0A0" FontSize="13" LineHeight="20" TextWrapping="Wrap">
                                <Run Foreground="#D0D0D0">•</Run> Game save files and profiles<LineBreak />
                                <Run Foreground="#D0D0D0">•</Run> Launcher settings and preferences<LineBreak />
                                <Run Foreground="#D0D0D0">•</Run> Controller mappings and performance modes<LineBreak />
                                <Run Foreground="#D0D0D0">•</Run> Any custom folders you add later
                            </TextBlock>
                            <Border Height="1" Background="#18FFFFFF" Margin="0,16" />
                            <CheckBox x:Name="SetupAutomaticBackupToggle" Foreground="White" FontSize="14"
                                      IsChecked="True" HorizontalContentAlignment="Left" HorizontalAlignment="Left"
                                      Content="Enable automatic backup" />
                            <TextBlock Foreground="#808080" FontSize="12" Margin="28,4,0,0" TextWrapping="Wrap"
                                       Text="Choose folders and backup drive anytime from the Backup panel on the home screen." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="MetadataPanel" Visibility="Collapsed" Width="620">
                    <TextBlock Text="ADD COVER ART (OPTIONAL)" Style="{StaticResource SetupSectionTitle}"
                               FontSize="24" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Foreground="#A0A0A0" FontSize="14" Margin="0,10,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Connect IGDB or SteamGridDB to fetch covers, backgrounds, and descriptions for your library." />
                    <Border Margin="0,24,0,0" Background="#18FFFFFF" CornerRadius="12" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="SOURCE NAME" Style="{StaticResource SetupFieldLabel}" />
                            <TextBox x:Name="SetupSourceName" Height="42" />
                            <TextBlock Text="API BASE URL" Style="{StaticResource SetupFieldLabel}" Margin="0,14,0,6" />
                            <TextBox x:Name="SetupSourceUrl" Height="42"
                                     Text="https://api.igdb.com/v4" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CLIENT ID (IGDB ONLY)" Style="{StaticResource SetupFieldLabel}" />
                                    <TextBox x:Name="SetupSourceClientId" Height="42" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="API KEY / CLIENT SECRET" Style="{StaticResource SetupFieldLabel}" />
                                    <PasswordBox x:Name="SetupSourceKey" Height="42" Padding="10" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SetupMetadataStatus" Foreground="{StaticResource AccentBrush}" FontSize="13"
                               Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="FinishPanel" Visibility="Collapsed">
                    <TextBlock Text="YOU ARE ALL SET" Style="{StaticResource SetupSectionTitle}"
                               FontSize="30" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Foreground="#A0A0A0" FontSize="15" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Here is what the shell will use:" />
                    <Border Margin="0,26,0,0" Background="#18FFFFFF" CornerRadius="12" Padding="20,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="INPUT METHOD" Style="{StaticResource SetupFieldLabel}" Foreground="#888888" />
                                <TextBlock x:Name="FinishInputText" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="PERFORMANCE MODE" Style="{StaticResource SetupFieldLabel}" Foreground="#888888" />
                                <TextBlock x:Name="FinishPerformanceText" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="DEFAULT DESKTOP" Style="{StaticResource SetupFieldLabel}" Foreground="#888888" />
                                <TextBlock x:Name="FinishDesktopText" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           TextTrimming="CharacterEllipsis" MaxWidth="360" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="METADATA SOURCE" Style="{StaticResource SetupFieldLabel}" Foreground="#888888" />
                                <TextBlock x:Name="FinishMetadataText" Text="None configured — you can add one later in Settings"
                                           FontSize="14" Foreground="#A0A0A0" HorizontalAlignment="Right"
                                           VerticalAlignment="Top" TextWrapping="Wrap" MaxWidth="360" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Foreground="#707070" FontSize="12" Margin="0,18,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Remember: Desktop Mode in the power menu returns you to Windows at any time." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="SetupFooter" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SetupSkipButton" Grid.Column="0" Style="{StaticResource SkipButtonStyle}"
                    Content="SKIP FOR NOW" Visibility="Collapsed" Click="SkipMetadata_Click" />
            <Button x:Name="SetupNextButton" Grid.Column="1" Style="{StaticResource PrimaryActionButton}"
                    Content="GET STARTED" Width="200" Height="48" Click="NextButton_Click" />
        </Grid>
    </Grid>
</Window>






