<Window x:Class="OmenGamingShell.WinKeyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OmenGamingShell"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        KeyDown="Overlay_KeyDown"
        PreviewKeyDown="Overlay_PreviewKeyDown"
        UseLayoutRounding="True">
    <Window.Resources>
        <local:ApplicationIconConverter x:Key="ApplicationIconConverter" />
        <Style x:Key="LibraryFilterButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FilterSurface" Background="{TemplateBinding Background}" CornerRadius="22">
                            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="White" Opacity="0.07" /></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FilterSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FilterSurface" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlaySlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="5" Background="#26FFFFFF" CornerRadius="2.5" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="#FF003C" CornerRadius="2.5" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="13" Height="13" Background="White" CornerRadius="6.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.55" Color="#000000" />
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskWindowCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="TaskCardSurface" Background="{TemplateBinding Background}" CornerRadius="13">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="TaskSelectionLine" Width="54" Height="3" CornerRadius="2"
                                    Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TaskCardSurface" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TaskCardSurface" Property="Background" Value="#20FFFFFF" />
                                <Setter TargetName="TaskSelectionLine" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TaskCardSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchDiamondButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DiamondCap" CornerRadius="20" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#FF003C" Opacity="0" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DiamondCap" Property="Background" Value="#2EFF003C" />
                                <Setter TargetName="DiamondCap" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#FF003C" Opacity="0.55" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DiamondCap" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" MouseDown="RootGrid_MouseDown">
        <Grid.Background>
            <RadialGradientBrush>
                <RadialGradientBrush.GradientStops>
                    <GradientStop Color="#22151515" Offset="0" />
                    <GradientStop Color="#E60A0A0A" Offset="0.62" />
                    <GradientStop Color="#F2050505" Offset="1" />
                </RadialGradientBrush.GradientStops>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid x:Name="ContentPanel" Margin="120,60,120,50" MouseDown="ContentPanel_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search bar -->
            <Grid Grid.Row="0" Height="56" Margin="0,0,0,28">
                <Border x:Name="SearchBorder" CornerRadius="28" Background="#F20F0F0F"
                        BorderBrush="#14FFFFFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#B0B0B0"
                                   VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 FontSize="21" Padding="56,0,64,0" VerticalContentAlignment="Center"
                                 Foreground="White" CaretBrush="{StaticResource AccentBrush}"
                                 TextChanged="SearchBox_TextChanged"
                                 GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                                 LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                                 AutomationProperties.Name="Search open windows and apps" />
                        <Button x:Name="SearchButton" Style="{StaticResource SearchDiamondButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Click="SearchButton_Click">
                            <Grid Width="15" Height="15">
                                <Path Data="M 7.5,0.5 L 14.5,7.5 L 7.5,14.5 L 0.5,7.5 Z" Fill="#FF003C" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- OPEN WINDOWS section label -->
            <StackPanel x:Name="WindowsSection" Grid.Row="1" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock Text="O P E N   W I N D O W S" FontSize="11" FontWeight="SemiBold" Foreground="#707070"
                           Margin="4,0,0,10" />
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Left">
                    <ItemsControl x:Name="WindowList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TaskWindowCardButton}" Width="196" Height="152" Margin="0,0,12,0"
                                        Tag="{Binding}" Click="TaskWindow_Click" AutomationProperties.Name="{Binding Title}">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="96" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="ThumbPreview" Tag="{Binding}" Background="#090909" CornerRadius="8" ClipToBounds="True" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,0">
                                            <Image Source="{Binding ExecutablePath, Converter={StaticResource ApplicationIconConverter}}"
                                                   Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="145" Foreground="#D0D0D0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- APPS section label (only when searching) -->
            <StackPanel x:Name="AppsSection" Grid.Row="2" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock Text="A P P S" FontSize="11" FontWeight="SemiBold" Foreground="#707070"
                           Margin="4,0,0,10" />
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Left">
                    <ItemsControl x:Name="AppsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TaskWindowCardButton}" Width="120" Height="130" Margin="0,0,10,0"
                                        Tag="{Binding}" Click="App_Click" HorizontalContentAlignment="Center">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="64" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#0C0C0C" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Width="56" Height="56">
                                            <Image Source="{Binding Cover, Converter={StaticResource ApplicationIconConverter}}"
                                                   Width="40" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="105"
                                                   VerticalAlignment="Top" Margin="0,4,0,0" Foreground="#D0D0D0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Empty state when no windows and no search -->
            <TextBlock x:Name="EmptyHint" Grid.Row="3" Text="Start typing to search apps" FontSize="15"
                       Foreground="#505050" HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed" />

            <!-- Dashboard widgets -->
            <Border x:Name="Dashboard" Grid.Row="4" Height="154" Margin="0,26,0,0" Panel.ZIndex="10"
                    Background="#ED0B0B0B" CornerRadius="18" Padding="14" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="6" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Top accent hairline -->
                    <Border Grid.Row="0" Height="2" CornerRadius="1" Margin="16,0,16,14" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FF003C" Offset="0" />
                                <GradientStop Color="#66FF003C" Offset="0.5" />
                                <GradientStop Color="#00FF003C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Media -->
                        <Border Grid.Column="0" CornerRadius="13" Padding="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1CFFFFFF" Offset="0" />
                                    <GradientStop Color="#09FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="1.5" Height="30" CornerRadius="1" Background="#FF003C"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Border x:Name="MediaArtBorder" Width="54" Height="54" CornerRadius="12"
                                        Background="#10FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        ClipToBounds="True" VerticalAlignment="Center" Margin="9,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.6" Color="#FF003C" />
                                    </Border.Effect>
                                    <Border x:Name="MediaArt" CornerRadius="11" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock x:Name="MediaTitle" Text="No media" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="MediaArtist" Text="" FontSize="9.5" Foreground="#909090"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    <UniformGrid Columns="3" Rows="1" Margin="0,9,0,0">
                                        <Button x:Name="MediaPrevButton" Style="{StaticResource LibraryFilterButton}"
                                                Content="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                Height="26" Width="30" Padding="0" Margin="0,0,4,0" Click="MediaPrev_Click" />
                                        <Button x:Name="MediaPlayButton" Style="{StaticResource LibraryFilterButton}"
                                                Content="&#xEDB8;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                Height="26" Width="36" Padding="0" Margin="0,0,4,0" Click="MediaPlay_Click" />
                                        <Button x:Name="MediaNextButton" Style="{StaticResource LibraryFilterButton}"
                                                Content="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                Height="26" Width="30" Padding="0" Click="MediaNext_Click" />
                                    </UniformGrid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="MediaMuteButton" Style="{StaticResource LibraryFilterButton}"
                                                Content="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                                Height="24" Width="32" Padding="0" Margin="0,0,6,0"
                                                Click="MediaMute_Click" />
                                        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                                Style="{StaticResource OverlaySlider}"
                                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                                        <TextBlock x:Name="VolumeValueText" Grid.Column="2" FontSize="9.5"
                                                   Foreground="#909090" TextAlignment="Right" VerticalAlignment="Center"
                                                   MinWidth="26" Margin="6,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Game Store -->
                        <Border Grid.Column="2" CornerRadius="13" Padding="12"
                                MouseLeftButtonUp="StoreClick" Cursor="Hand">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#402B1A4A" Offset="0" />
                                    <GradientStop Color="#12090A1E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="1.5" Height="30" CornerRadius="1" Background="#9B6BFF"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Border x:Name="StoreArt" Width="54" Height="54" CornerRadius="12"
                                        Background="#10FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        ClipToBounds="True" VerticalAlignment="Center" Margin="9,0,0,0">
                                    <Border x:Name="StoreArtInner" CornerRadius="11" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GAME STORE" FontSize="9" FontWeight="SemiBold" Foreground="#B59BFF" />
                                        <Border Background="#2E9B6BFF" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                            <TextBlock Text="FEATURED" FontSize="7.5" FontWeight="Bold" Foreground="#D4C6FF" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="StoreGameName" Text="Nothing featured" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    <TextBlock x:Name="StoreGameDev" Text="" FontSize="9" Foreground="#909090"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Text="Launch deal  >" FontSize="9" Foreground="#B59BFF" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Notifications -->
                        <Border Grid.Column="4" CornerRadius="13" Padding="12"
                                MouseLeftButtonUp="NotificationClick" Cursor="Hand">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1CFFFFFF" Offset="0" />
                                    <GradientStop Color="#09FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="1.5" Height="30" CornerRadius="1" Background="#E8B83C"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Border Width="40" Height="40" CornerRadius="11" Background="#14FFFFFF"
                                        VerticalAlignment="Center" Margin="9,0,0,0">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                               Foreground="#E8B83C" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="NOTIFICATIONS" FontSize="9" FontWeight="SemiBold" Foreground="#D9B96A" />
                                    <TextBlock x:Name="NotificationTitle" Text="No notifications" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    <TextBlock x:Name="NotificationMessage" Text="" FontSize="9.5" Foreground="#909090"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Performance mode -->
                        <Border Grid.Column="6" CornerRadius="13" Padding="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1CFFFFFF" Offset="0" />
                                    <GradientStop Color="#09FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="1.5" Height="30" CornerRadius="1" Background="#24C486"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0">
                                    <TextBlock Text="PERFORMANCE MODE" FontSize="9" FontWeight="SemiBold" Foreground="#7FD9B4" />
                                    <TextBlock x:Name="PerfModeText" Text="BALANCED" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#24C486" Margin="0,3,0,0" />
                                    <UniformGrid Columns="3" Rows="1" Margin="0,8,0,0">
                                        <Button Style="{StaticResource LibraryFilterButton}" Content="ULT" Tag="Ultimate" FontSize="9" FontWeight="SemiBold"
                                                Height="25" Margin="0,0,5,0" Click="PerformanceMode_Click" />
                                        <Button Style="{StaticResource LibraryFilterButton}" Content="BAL" Tag="Balanced" FontSize="9" FontWeight="SemiBold"
                                                Height="25" Margin="0,0,5,0" Click="PerformanceMode_Click" />
                                        <Button Style="{StaticResource LibraryFilterButton}" Content="ECO" Tag="Eco" FontSize="9" FontWeight="SemiBold"
                                                Height="25" Click="PerformanceMode_Click" />
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
