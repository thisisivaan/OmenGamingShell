<Window x:Class="OmenGamingShell.InGameHomeOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Maximized" Topmost="True" ShowInTaskbar="False" Foreground="White"
        KeyDown="Overlay_KeyDown">
    <Grid Background="#01000000">
        <Border Width="1120" Height="520" Padding="42" Background="#E80A0A0A"
                CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="OMEN" FontFamily="Segoe UI Variable Display" FontSize="34"
                               FontWeight="Bold" Foreground="#FF003C" HorizontalAlignment="Center" />
                    <TextBlock x:Name="RunningGameText" Foreground="#999" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
                <ItemsControl x:Name="OverlayGames" Grid.Row="1" Margin="0,34,0,25">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Width="170" Height="226" CornerRadius="10" Margin="8">
                            <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="2" Text="B / ESC  RETURN TO GAME" HorizontalAlignment="Center" Foreground="#999" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
