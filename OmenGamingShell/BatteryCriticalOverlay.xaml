<Window x:Class="OmenGamingShell.BatteryCriticalOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Maximized" Topmost="True" ShowInTaskbar="False" Foreground="White"
        ResizeMode="NoResize">
    <Grid Background="#E6000000">
        <Border Width="760" Padding="52,44" Background="#E80A0A0A"
                CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE9F2;" FontFamily="Segoe Fluent Icons" FontSize="56" Foreground="#FF003C"
                           HorizontalAlignment="Center" Margin="0,0,0,18" />
                <TextBlock x:Name="ThresholdText" FontFamily="Segoe UI Variable Display" FontSize="22"
                           FontWeight="Bold" Foreground="#FF003C" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="BatteryPercentText" Foreground="#FFFFFF" FontSize="34" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="CONNECT TO A POWER SOURCE" Foreground="#FFFFFF" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="The laptop will shut down once the battery is drained. This message will go away automatically when the charger is plugged in."
                           Foreground="#999" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>